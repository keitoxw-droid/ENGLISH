            for _ = 1, 20 do
                local angle = math.random() * 2 * math.pi
                local radius = MIN_RADIUS + math.random() * (MAX_RADIUS - MIN_RADIUS)
                local candidate = myPos + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
                local tooClose = false
                for _, pos in pairs(placedPositions) do
                    if (candidate - pos).Magnitude < MIN_DIST then tooClose = true break end
                end
                if not tooClose then return candidate end
            end
            local angle = math.random() * 2 * math.pi
            return myPos + Vector3.new(math.cos(angle) * MAX_RADIUS, 0, math.sin(angle) * MAX_RADIUS)
        end

        local colorsList = {"LightsSpotLightRed", "LightsSpotLightToothpaste", "LightsSpotLightPink", "LightsSpotLightGreen", "LightsSpotLightWhite"}

