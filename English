                local uis = game:GetService("UserInputService")
                local isUIBoost = getBoostBtn and getBoostBtn()
                local isUIUp    = getUpBtn and getUpBtn()
                local isUIDown  = getDownBtn and getDownBtn()
                
                local isBoosting = uis:IsKeyDown(Enum.KeyCode.LeftShift) or isUIBoost
                local speed = isBoosting and boostSpeed or maxSpeed
                
                local isUp   = uis:IsKeyDown(Enum.KeyCode.Space) or uis:IsKeyDown(Enum.KeyCode.E) or isUIUp
                local isDown = uis:IsKeyDown(Enum.KeyCode.LeftControl) or uis:IsKeyDown(Enum.KeyCode.Q) or isUIDown
                
                local camCF  = workspace.CurrentCamera.CFrame
                
                -- Vecteur de deplacement 3D
                local moveVec = Vector3.new(0,0,0)
                
                -- Support Universel (PC + Mobile Joystick)
                if hum and hum.MoveDirection.Magnitude > 0 then
                    -- MoveDirection est deja projetÃƒÂ© par rapport a la camera, on l'utilise direct pour le plan XZ
                    moveVec = moveVec + Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z)
                end
                
                -- Application axe Y (Monter / Descendre)
                if isUp   then moveVec = moveVec + Vector3.new(0,1,0) end
                if isDown then moveVec = moveVec - Vector3.new(0,1,0) end
                
                local moving = moveVec.Magnitude > 0.01
                if moving then 
                    moveVec = moveVec.Unit 
                    targetSpeed = speed 
                    isMoving = true 
                end
                
                -- Inertie rapide
                currentVelocity = currentVelocity + (targetSpeed - currentVelocity) * dt * 40
                
                -- Orientation INSTANTANEE vers la camera (plus de lerp, reaction directe)
                local camYaw = (math.atan2 or math.atan)(-camCF.LookVector.X, -camCF.LookVector.Z)
                currentWyvernCF = CFrame.new(currentWyvernCF.Position) * CFrame.Angles(0, camYaw, 0)
                
                -- TRANSLATION DIRECTE (on applique le vecteur de deplacement, pas le LookVector du wyvern)
                -- Si on ne bouge plus, on continue a glisser un peu dans notre direction actuelle (Inertie du strafe)
                local disp
                if moving then
                    disp = moveVec * currentVelocity * dt
                else
                    disp = currentWyvernCF.LookVector * currentVelocity * dt * 0.3
                end
                
                local nextPos = currentWyvernCF.Position + disp
                
                local ignores = {lp.Character}
                for _, p in ipairs(wyvernParts) do if p.propModel then table.insert(ignores, p.propModel) end end
                wyvernRayParams.FilterDescendantsInstances = ignores
                local res = workspace:Raycast(currentWyvernCF.Position + Vector3.new(0,10,0), Vector3.new(0,-2000,0), wyvernRayParams)
                local minHeight = res and (res.Position.Y + 4) or -3000
                
                nextPos = Vector3.new(
                    math.clamp(nextPos.X, -3000, 3000), 
                    math.clamp(nextPos.Y, minHeight, 2000), 
                    math.clamp(nextPos.Z, -3000, 3000)
                )
                currentWyvernCF = currentWyvernCF - currentWyvernCF.Position + nextPos

            elseif wyvernState == "landing" then
                -- Atterrissage ultra rapide (1 seconde)
                wyvernStateTime = wyvernStateTime + dt
                local progress = math.min(wyvernStateTime / 1.0, 1)
                local easedP = progress^2  -- ease-in: accÃƒÂ©lÃƒÂ¨re en descendant
                local fromY = landingStartY  -- Y au moment du declenchement
                local toY   = landingTargetY

                local newY  = fromY + (easedP * (toY - fromY))
                currentVelocity = currentVelocity * 0.92
                currentWyvernCF = currentWyvernCF - curY + Vector3.new(curY.X, newY, curY.Z)
                if progress >= 1 then
                    wyvernState = "grounded"
                    updateGuiBtns()
                end
            end

            -- SPEED RATIO pour l'intensitÃƒÂ© des animations d'ailes
            local speedRatio = currentVelocity / maxSpeed
            local isFlying = (wyvernState == "flying" or wyvernState == "takeoff" or wyvernState == "landing")
            local isSleeping = (not isFlying and currentVelocity < 2)

            -- Cleanup auto si toutes les pieces sont detruites
            if #wyvernParts > 0 then
                local alive = false
                for _, p in ipairs(wyvernParts) do
                    if p.scf and p.scf.Parent then alive = true break end
                end
                if not alive then
                    wyvernParts = {}
                    hideRiderGui()
                    wasRiding = false
                    wyvernState = "grounded"
                end
            end

            if isSitting and not wasRiding then
                wasRiding = true
                showRiderGui()
            elseif not isSitting and wasRiding then
                wasRiding = false
                hideRiderGui()
            end

            for _, pData in ipairs(wyvernParts) do
                local bp = pData.blueprint
                if bp and pData.scf then
                    -- L'animation dÃƒÂ©pend de si on bouge ou pas (vol vs hover)
                    local flapForce = math.max(0.2, speedRatio)
                    if isSleeping then flapForce = 0 end
                    local animDelta = bp.anim(t, flapForce, isSleeping)
                    
                    -- Dynamic wing folding on dive (Seulement si on est en mouvement)
                    if not isSleeping and bp.key:sub(1,4) == "aile" and currentVelocity > 10 then
                        local pitch = math.asin(currentWyvernCF.LookVector.Y)
                        if pitch < -0.3 then
                            -- On replie les ailes si on plonge
                            animDelta = animDelta * CFrame.Angles(0, 0, math.rad(-30))
                        end
                    end
                    
                    local partCF = currentWyvernCF * CFrame.new(bp.off) * bp.rot * animDelta
                    wStream:setCF(pData.scf, partCF)
                end
            end
        end)
    end



