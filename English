local KeysToNotes = {}
do
    local notes = {}
    for note in pairs(PianoNotes) do table.insert(notes, note) end
    table.sort(notes, function(a, b)
        local pitch = {["C"]=0,["C#"]=1,["D"]=2,["D#"]=3,["E"]=4,["F"]=5,["F#"]=6,["G"]=7,["G#"]=8,["A"]=9,["A#"]=10,["B"]=11}
