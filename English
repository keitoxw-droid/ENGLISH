-- [LOCKED: WORK PERFECTLY] Core bring function (canoe pattern: SetPrimaryPartCFrame, velocity 70 exit)
local function _bringVehicleToPlayer(car, seat, targetCF)
    local lp   = game:GetService("Players").LocalPlayer
    local char = lp.Character or lp.CharacterAdded:Wait()
    local hrp  = char:WaitForChild("HumanoidRootPart")
    local hum  = char:WaitForChild("Humanoid")

    pcall(function() hum.Sit = false end)
    task.wait(0.05)
    for _ = 1, 15 do
        pcall(function() hrp.CFrame = seat.CFrame * CFrame.new(0, 1.5, 0) end)
        task.wait(0.1)
        if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
            pcall(function() seat:Sit(hum) end)
        end
        if hum.Sit then break end
    end
    task.wait(0.5)
    if not hum.Sit then return false end

    if not car.PrimaryPart then
        pcall(function() car.PrimaryPart = seat end)
    end
    pcall(function()
        if car.PrimaryPart then
            car:SetPrimaryPartCFrame(targetCF)
        else
            car:PivotTo(targetCF)
        end
    end)
    task.wait(0.5)

    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
    pcall(function() hum.Sit = false end)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    pcall(function() hum.Jump = true end)
    local nowHrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if nowHrp then
        pcall(function()
            nowHrp.AssemblyLinearVelocity = Vector3.new(0, 70, 0)
            nowHrp.Velocity               = Vector3.new(0, 70, 0)
        end)
    end
    task.wait(0.1)
    pcall(function() hum.Jump = false end)
    task.wait(0.5)
    return true
end

