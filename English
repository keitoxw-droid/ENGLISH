-- CANOE SPAM - SPAM DE CANOES SUR LA MAP
-- Source: pattern Jet Spam de GOAT HUB.txt (lignes 1323-1459)
--         + pattern Fling Canoe de 2.lua (lignes 1688-1704) pour le spawn
-- Mecanisme: va au 001_CanoeCloneButton -> fireclickdetector ->
--            recupere le canoe dans 001_CanoeStorage ->
--            le teleporte vers des destinations sur la map (boucle)
--            -> le joueur monte dans le 1er canoe pose (sit)
-- [LOCKED: WORK PERFECTLY] SYSTEME ANTI-SIT (pattern EXACT du Pirate Ship Tornado):
--   l'anti-sit est coupe pendant TOUTE la session canoe (start -> stop),
--   puis restaure au stop / descente. Le joueur est TP sur le seat du canoe.
-- ============================================================
do
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    local CanoeSpamActive = false

    local function getCanoeComponents()
        local wc = workspace:FindFirstChild("WorkspaceCom")
        if not wc then return nil, nil end
        local buttonPart = wc:FindFirstChild("001_CanoeCloneButton")
        local storage = wc:FindFirstChild("001_CanoeStorage")
        if not buttonPart or not storage then return nil, nil end
        local button = buttonPart:FindFirstChild("Button")
        if not button then return nil, nil end
        local detector = button:FindFirstChild("ClickDetector")
        return detector, storage
    end

    local function startCanoeSpam()
        CanoeSpamActive = true
        task.spawn(function()
            local lp = game:GetService("Players").LocalPlayer
            local wc = workspace:FindFirstChild("WorkspaceCom")
            local buttonPart = wc and wc:FindFirstChild("001_CanoeCloneButton") and wc["001_CanoeCloneButton"]:FindFirstChild("Button")
            local detector = buttonPart and buttonPart:FindFirstChild("ClickDetector")
            local storage = wc and wc:FindFirstChild("001_CanoeStorage")

            if not buttonPart or not detector then
                pcall(function()
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "Canoe Spam",
                        Text = "Canoe button not found on the map!",
                        Duration = 3
                    })
                end)
                CanoeSpamActive = false
                return
            end

            local char = lp.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local originalCF = hrp and hrp.CFrame

            _G.withAntiSitDisabled(function()
                while CanoeSpamActive do
                    char = lp.Character
                    hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")

                    if hrp and buttonPart then
                        -- 1) TP sur le bouton + Clic
                        pcall(function() hrp.CFrame = buttonPart.CFrame end)
                        task.wait(0.1)
                        pcall(function() fireclickdetector(detector, 0) end)
                        pcall(function() fireclickdetector(detector) end)
                    end

                    -- [INTERVAL 0.5s] Attente post-clic pour le spawn
                    task.wait(0.5)

                    -- 2) Détection du Canoë, TP sur VehicleSeat et déplacement au Spawn
                    if storage then
                        for _, canoe in ipairs(storage:GetChildren()) do
                            if canoe:IsA("Model") and not canoe:GetAttribute("BTRSpread") then
                                pcall(function() canoe:SetAttribute("BTRSpread", true) end)

                                local seat = canoe:FindFirstChildOfClass("VehicleSeat") 
                                          or canoe:FindFirstChildOfClass("Seat") 
                                          or canoe:FindFirstChild("VehicleSeat")
                                          or canoe:FindFirstChild("Hull")
                                          or canoe:FindFirstChildWhichIsA("BasePart")

                                if seat and hrp and hum then
                                    if not canoe.PrimaryPart then
                                        pcall(function() canoe.PrimaryPart = seat end)
                                    end

                                    -- 3) TP sur le siège + Sit
                                    pcall(function() hum.Sit = false end)
                                    task.wait(0.05)
                                    
                                    for _ = 1, 6 do
                                        pcall(function() hrp.CFrame = seat.CFrame * CFrame.new(0, 1.5, 0) end)
                                        task.wait(0.05)
                                        if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
                                            pcall(function() seat:Sit(hum) end)
                                        end
                                        if hum.Sit then break end
                                    end

                                    -- [INTERVAL 0.5s] Pause assise (Network Ownership)
                                    task.wait(0.5)

                                    if hum.Sit then
                                        -- 4) Déplacement du Canoë au Spawn (position aléatoire)
                                        local angle = math.random() * math.pi * 2
                                        local radius = math.random(5, 35)
                                        local destX = -16 + math.cos(angle) * radius
                                        local destZ = -47 + math.sin(angle) * radius
                                        local destCF = CFrame.new(destX, 4, destZ)

                                        pcall(function()
                                            if canoe.PrimaryPart then
                                                canoe:SetPrimaryPartCFrame(destCF)
                                            else
                                                canoe:PivotTo(destCF)
                                            end
                                        end)

                                        -- [INTERVAL 0.5s] Pause après le TP du véhicule
                                        task.wait(0.5)

                                        -- 5) Saut forcé et éjection du siège (méthode physique garantie)
                                        pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
                                        pcall(function() hum.Sit = false end)
                                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                                        pcall(function() hum.Jump = true end)
                                        if hrp then
                                            pcall(function()
                                                hrp.AssemblyLinearVelocity = Vector3.new(0, 70, 0)
                                                hrp.Velocity = Vector3.new(0, 70, 0)
                                            end)
                                        end
                                        task.wait(0.1)
                                        pcall(function() hum.Jump = false end)

                                        -- [INTERVAL 0.5s] Pause après être debout
                                        task.wait(0.5)
                                    end
                                end
                            end
                        end
                    end
                end

                -- Restaure la position initiale au stop
                char = lp.Character
                hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp and originalCF then
                    pcall(function() hrp.CFrame = originalCF end)
                end
            end)
        end)
    end
    local function stopCanoeSpam()
