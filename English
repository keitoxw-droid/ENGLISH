-- Helper Server Hop
local function performServerHop(mode)
    task.spawn(function()
        local TS = game:GetService("TeleportService")
        local HttpService = game:GetService("HttpService")
        local Players = game:GetService("Players")
        local StarterGui = game:GetService("StarterGui")
        local placeId = game.PlaceId
        local currentJob = game.JobId

        StarterGui:SetCore("SendNotification", {Title="Server Hop", Text="Searching for server (" .. mode .. ")...", Duration=3})

        local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=" .. (mode == "Small" and "Asc" or "Desc") .. "&limit=100"
        local success, result = pcall(function()
            return game:HttpGet(url)
        end)

        if not success or not result then
            StarterGui:SetCore("SendNotification", {Title="Server Hop", Text="Failed to fetch servers list.", Duration=3})
            return
        end

        local data = nil
        pcall(function() data = HttpService:JSONDecode(result) end)

        if not data or not data.data or #data.data == 0 then
            StarterGui:SetCore("SendNotification", {Title="Server Hop", Text="No servers found!", Duration=3})
            return
        end

        local eligibleServers = {}
        for _, s in ipairs(data.data) do
            if type(s) == "table" and s.id and s.id ~= currentJob and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
                if mode == "Small" and s.playing <= 8 then
                    table.insert(eligibleServers, s.id)
                elseif mode == "Large" and s.playing >= (s.maxPlayers - 4) then
                    table.insert(eligibleServers, s.id)
                elseif mode == "Random" then
                    table.insert(eligibleServers, s.id)
                end
            end
        end

        -- Fallback si aucun serveur ne correspond aux critères stricts
        if #eligibleServers == 0 then
            for _, s in ipairs(data.data) do
                if type(s) == "table" and s.id and s.id ~= currentJob and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
                    table.insert(eligibleServers, s.id)
                end
            end
        end

        if #eligibleServers > 0 then
            local targetServer = eligibleServers[math.random(1, #eligibleServers)]
            StarterGui:SetCore("SendNotification", {Title="Server Hop", Text="Teleporting to new server...", Duration=3})
            pcall(function()
                TS:TeleportToPlaceInstance(placeId, targetServer, Players.LocalPlayer)
            end)
        else
            StarterGui:SetCore("SendNotification", {Title="Server Hop", Text="No eligible server available.", Duration=3})
        end
    end)
end

