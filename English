                local conn = TCS.MessageReceived:Connect(function(msg)
                    if not msg then return end
                    local textContent = msg.Text or msg.RawText
                    if not textContent then return end

                    local sender = nil
                    if msg.TextSource then
                        sender = Players:GetPlayerByUserId(msg.TextSource.UserId)
                    end
                    if not sender and msg.TextChannel then
                        -- Recherche de repli
                        for _, p in ipairs(Players:GetPlayers()) do
