-- [LOCKED: WORK PERFECTLY] Scan des vehicules joueurs (Owner/Chassis/GUID)
-- [FIX Keito] Filtre les vehicules OCCUPES (le Carjack ne fonctionne que sur les libres)
local function scanVehicles()
    _G.FunVehicleData = {}
    _G.FunVehicleLabels = { "---" }
    _G.FunLabelToKey = {}
    local vehiclesFolder = workspace:FindFirstChild("Vehicles")
    if not vehiclesFolder then return end
    -- Pseudos des joueurs en ligne
    local playerNames = {}
    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
        playerNames[string.lower(p.Name)] = true
    end
    -- Noms des vehicules du JEU (noms courts, sans GUID)
    local gameVehicleNames = { "yacht", "fire truck", "firetruck", "ambulance", "police", "helicopter", "jet", "boat", "canoe", "bicycle", "tractor", "bus", "trailer", "forklift", "golf", "atv", "quad", "bmx", "bike", "motorcycle", "scooter", "seaplane" }
    for _, v in ipairs(vehiclesFolder:GetChildren()) do
        pcall(function()
            if not v:IsA("Model") then return end
            -- Recherche profonde du siege
            local seat = nil
            for _, d in ipairs(v:GetDescendants()) do
                if d:IsA("VehicleSeat") or d:IsA("Seat") then
                    seat = d
                    break
                end
            end
            if not seat then return end
            -- [FIX Keito v6] BANIR les vehicules du JEU:
            -- le prefixe "BROOKHAVEN -" = vehicule game (jamais un joueur)
            -- => on les vire TOUS, meme s'ils ont un GUID/Chassis.
            if string.find(string.lower(v.Name), "brookhaven", 1, true) then return end
            -- Owner value (ObjectValue avec le pseudo)
            local ownerVal = v:FindFirstChild("Owner")
            local ownerName = nil
            if ownerVal then
                pcall(function() ownerName = tostring(ownerVal.Value) end)
            end
            -- Fallback : pseudo de joueur dans le nom du vehicule
            local lowerName = string.lower(v.Name)
            if not ownerName then
                for pname, _ in pairs(playerNames) do
                    if string.find(lowerName, pname, 1, true) then
                        ownerName = pname
                        break
                    end
                end
            end
            -- Un GUID (ex: -9b66014f) = vehicule spawné par un joueur
            local hasGuid = string.find(lowerName, "-%x+") ~= nil
            local hasChassis = v:FindFirstChild("Chassis") ~= nil
            -- Pattern Brookhaven: le nom du vehicule joueur est "<pseudo>Car" (ex: "KeitoCar")
            -- ou contient le pseudo suivi de "car"
            local isPlayerNamed = false
            local ownerNameLower = ownerName and string.lower(ownerName) or ""
            if ownerNameLower ~= "" then
                if string.find(lowerName, ownerNameLower .. "car", 1, true) then
                    isPlayerNamed = true
                end
            end
            -- Filtre TRES STRICT: garde UNIQUEMENT les vehicules de joueurs.
            -- Attention: les vehicules du JEU (ex: "BROOKHAVAN - ...") ont aussi
            -- une Owner value => on NE se fie PLUS a ownerVal seul.
            -- Criteres fiables (vehicules spawnes par joueurs en Brookhaven):
            --  - GUID dans le nom (ex: "KeitoCar-9b66014f"), OU
            --  - nom contenant "<pseudo>car", OU
            --  - Chassis present
            -- [FIX Keito v6] EXIGER un pseudo de joueur en ligne:
            --  - ownerVal doit matcher un pseudo en ligne, OU
            --  - le nom doit contenir le pseudo d'un joueur en ligne
            local ownerIsOnline = false
            if ownerName then
                ownerIsOnline = playerNames[string.lower(ownerName)] == true
            end
            local nameHasOnline = false
            for pname, _ in pairs(playerNames) do
                if string.find(lowerName, pname, 1, true) then
                    nameHasOnline = true
                    break
                end
            end
            local isPlayerVehicle = (hasGuid or isPlayerNamed or hasChassis) and (ownerIsOnline or nameHasOnline)
            if not isPlayerVehicle then return end
            local occupied = seat.Occupant ~= nil
            -- [FIX Keito] On ne propose PAS les vehicules occupes
            if occupied then return end
            -- [FIX Keito v9] DETECTION "SUR LE SOL":
            -- si le vehicule est dans les airs (respawn/fling en cours),
            -- on le SKIP. Sinon le carjack vise la mauvaise zone et
            -- le joueur se fait kill. On accepte une petite marge
            -- (les vehicules Brookhaven ont des roues ~3-4 studs).
            local groundCheck = v.PrimaryPart or v:FindFirstChildOfClass("MeshPart") or v:FindFirstChildOfClass("Part")
            if groundCheck then
                -- Raycast vers le bas, en EXCLUANT le vehicule lui-meme
                -- (sinon le raycast touche ses roues et la distance est ~0)
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = { v }
                local rayOrigin = groundCheck.Position + Vector3.new(0, 1, 0)
                local rayDir = Vector3.new(0, -50, 0)
                local rayHit = workspace:Raycast(rayOrigin, rayDir, rayParams)
                if rayHit then
                    local distToGround = (groundCheck.Position.Y + 1 - rayHit.Position.Y)
                    -- Marge de 8 studs max: au-dessus => dans les airs => SKIP
                    if distToGround > 8 then return end
                end
            end
            local key = v.Name
            -- Nom propre sans GUID (ex: "KeitoCar-9b66014f" -> "KeitoCar")
            local cleanName = key:gsub("%-%-?%x+$", "")
            if cleanName == "" then cleanName = key end
            _G.FunVehicleData[key] = { model = v, seat = seat, occupied = false, ownerName = ownerName, cleanName = cleanName }
            -- [FIX Keito v7] UNIQUEMENT le nom du joueur dans la liste.
            -- Plus de "Pseudo - NomPropre (FREE)": juste "Keito".
            -- Fallback: nom propre du vehicule si pas de pseudo (rare).
            local display = (ownerName and ownerName ~= "") and ownerName or cleanName
            _G.FunLabelToKey[display] = key
            table.insert(_G.FunVehicleLabels, display)
        end)
    end
end

