    -- VEHICLE FLING (Anti-Hacker) - Ambulance, Brookhaven handles the rest
    -- ========================================================
    do
        local vehicleFlingRunning = false
        local vehicleFlingConnection = nil
        local vehicleFlingCar = nil
        local vehicleFlingReturnCF = nil
        _G.FlingVehicle = "Ambulance"

        local function getVehiclePart(car)
            if not car then return nil end
            if car.PrimaryPart then return car.PrimaryPart end
            local body = car:FindFirstChild("Body")
            if body then return body end
            return car:FindFirstChildOfClass("MeshPart") or car:FindFirstChildOfClass("Part")
        end

        -- [LOCKED: WORK PERFECTLY] VEHICLE FLING (Anti-Hacker)
        local vehicleFlingToggleRef = nil
        local isStoppingVehicleFling = false

        local function stopVehicleFling(silent, success)
            if isStoppingVehicleFling then return end
            isStoppingVehicleFling = true

            vehicleFlingRunning = false
            _G.VehicleFlingActive = false
            _G.VehicleFlingCar = nil

            if vehicleFlingConnection then
                vehicleFlingConnection:Disconnect()
                vehicleFlingConnection = nil
            end

            local lp = game:GetService("Players").LocalPlayer
            local char = lp.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            -- Freeze immediat : aucun mouvement parasite / degats possibles
            if hrp then pcall(function() hrp.Anchored = true end) end

            -- 1. Kill velocite vehicule
            local vPart = getVehiclePart(vehicleFlingCar)
            if vPart then
                pcall(function()
                    vPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    vPart.AssemblyAngularVelocity = Vector3.zero
                    vPart.RotVelocity = Vector3.new(0,0,0)
                    vPart.Velocity = Vector3.new(0,0,0)
                end)
            end
            task.wait()

            -- 2. Ejecter du siege
            if hum then
                hum.Sit = false
                pcall(function() hum:UnequipTools() end)
            end
            task.wait()

            -- 3. Kill velocite HRP
            if hrp and hrp.Parent then
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    hrp.RotVelocity = Vector3.new(0,0,0)
                    hrp.Velocity = Vector3.new(0,0,0)
                end)
            end

            -- 4. Vehicule underground
            if vehicleFlingCar then
                pcall(function()
                    vehicleFlingCar:PivotTo(CFrame.new(0, -90000, 0))
                end)
            end
            task.wait(0.1)

            -- 5. Delete vehicules
            local RE2 = game:GetService("ReplicatedStorage"):FindFirstChild("RE")
            local carRemote = RE2 and RE2:FindFirstChild("1Ca1r")
            if carRemote then pcall(function() carRemote:FireServer("DeleteAllVehicles") end) end
            task.wait(0.15)

            -- 6. Force TP retour (3 passes)
            if hrp and vehicleFlingReturnCF then
                for _ = 1, 3 do
                    pcall(function() hrp.CFrame = vehicleFlingReturnCF end)
                    task.wait()
                end
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    hrp.RotVelocity = Vector3.new(0,0,0)
                    hrp.Velocity = Vector3.new(0,0,0)
                end)
                vehicleFlingReturnCF = nil
            end

            -- 7. Unfreeze apres flush 5 frames
            task.spawn(function()
                for _ = 1, 5 do
                    task.wait()
                    if hrp and hrp.Parent then
                        pcall(function()
                            hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                            hrp.Velocity = Vector3.new(0,0,0)
                        end)
                    end
                end
                if hrp and hrp.Parent then pcall(function() hrp.Anchored = false end) end
                isStoppingVehicleFling = false
            end)

            vehicleFlingCar = nil

            -- Reset toggle UI sans boucle
            if vehicleFlingToggleRef then
                pcall(function() vehicleFlingToggleRef:Set(false) end)
            end

            if not silent then
                local notifText = (success == true) and "Target flinged to the void!" or "Attack cancelled."
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Vehicle Fling",
                    Text = notifText,
                    Duration = 3
                })
            end
        end

        TrollTab:AddSection({"》 Vehicle Fling"})

        vehicleFlingToggleRef = TrollTab:AddToggle({
            Name = "Vehicle Fling V1",
            Description = "Spawns vehicle V1 and flings the target.",
            Default = false,
            Callback = function(state)
                if state then
                    local lp = game:GetService("Players").LocalPlayer
                    local targetName = _G.TrollTarget
                    local targetPlayer = nil
                    if targetName and targetName ~= "---" and targetName ~= "" then
                        targetPlayer = game:GetService("Players"):FindFirstChild(targetName)
                    end

                    if not targetPlayer then
                        game:GetService("StarterGui"):SetCore("SendNotification", {Title="Vehicle Fling", Text="Select a target first!", Duration=3})
                        if vehicleFlingToggleRef then pcall(function() vehicleFlingToggleRef:Set(false) end) end
                        return
                    end

                    -- Save position before everything to come back
                    vehicleFlingReturnCF = lp.Character and (lp.Character.PrimaryPart and lp.Character.PrimaryPart.CFrame or (lp.Character:FindFirstChild("HumanoidRootPart") and lp.Character.HumanoidRootPart.CFrame)) or CFrame.new(0, 5, 0)

                    -- TP to safe spawn zone where vehicles are guaranteed to spawn
                    local char = lp.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        pcall(function() hrp.CFrame = CFrame.new(-1250.97, 78.58, -1258.14) end)
                    end
                    task.wait(0.2)

                    -- Spawn the vehicle (Brookhaven handles the attack)
                    local RE = game:GetService("ReplicatedStorage"):WaitForChild("RE")
                    _G.VehicleFlingActive = true
                    pcall(function() RE:WaitForChild("1Ca1r"):FireServer("PickingCar", _G.FlingVehicle) end)
                    task.wait(1.5)

                    -- Find the spawned vehicle: name-based (<Username>Car) anywhere
                    local myVehicle = nil
                    local expectedName = lp.Name .. "Car"
                    local vehiclesFolder = workspace:FindFirstChild("Vehicles")
                    local listToSearch = vehiclesFolder and vehiclesFolder:GetChildren() or workspace:GetChildren()

                    -- Pass 1: exact name match
                    for _, v in pairs(listToSearch) do
                        if v:IsA("Model") and v.Name == expectedName then
                            myVehicle = v
                            break
                        end
                    end

                    -- Pass 2: closest vehicle with a seat near player
                    if not myVehicle then
                        local closestDist = math.huge
                        local charPos = lp.Character and lp.Character.PrimaryPart and lp.Character.PrimaryPart.Position or Vector3.new(0,0,0)
                        for _, v in pairs(listToSearch) do
                            if v:IsA("Model") then
                                local hasSeat = false
                                for _, d in pairs(v:GetDescendants()) do
                                    if d:IsA("VehicleSeat") then hasSeat = true break end
                                end
                                if hasSeat then
                                    local pPart = v.PrimaryPart or v:FindFirstChild("Body") or v:FindFirstChildOfClass("Part") or v:FindFirstChildOfClass("MeshPart")
                                    if pPart then
                                        local dist = (pPart.Position - charPos).Magnitude
                                        if dist < closestDist and dist < 30 then
                                            closestDist = dist
                                            myVehicle = v
                                        end
                                    end
                                end
                            end
                        end
                    end

                    vehicleFlingCar = myVehicle
                    _G.VehicleFlingCar = myVehicle

                    if not myVehicle then
                        game:GetService("StarterGui"):SetCore("SendNotification", {Title="Vehicle Fling", Text="Vehicle not found!", Duration=3})
                        _G.VehicleFlingCar = nil
                        _G.VehicleFlingActive = false
                        if vehicleFlingToggleRef then pcall(function() vehicleFlingToggleRef:Set(false) end) end
                        return
                    end

                    -- Teleport the vehicle to us
                    pcall(function()
                        myVehicle:PivotTo(lp.Character.PrimaryPart.CFrame * CFrame.new(0, 0, -8))
                    end)
                    task.wait(0.3)

                    -- Find driver seat, disable all other seats
                    local seat = nil
                    for _, d in pairs(myVehicle:GetDescendants()) do
                        if d:IsA("VehicleSeat") then seat = d break end
                    end

                    if not seat then
                        game:GetService("StarterGui"):SetCore("SendNotification", {Title="Vehicle Fling", Text="Seat not found!", Duration=3})
                        _G.VehicleFlingActive = false
                        _G.VehicleFlingCar = nil
                        if vehicleFlingToggleRef then pcall(function() vehicleFlingToggleRef:Set(false) end) end
                        return
                    end

                    -- Disable all other seats
                    for _, v in pairs(myVehicle:GetDescendants()) do
                        if (v:IsA("Seat") or v:IsA("VehicleSeat")) and v ~= seat then
                            v.Disabled = true
                            pcall(function() v.CanTouch = false end)
                        end
                    end

                    -- Sit to take network ownership
                    local myChar = lp.Character
                    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

                    if myHrp and myHum then
                        myHrp.CFrame = seat.CFrame + Vector3.new(0, 1.5, 0)
                        task.wait(0.2)
                        seat:Sit(myHum)
                        local waitCount = 0
                        while not myHum.Sit and waitCount < 10 do
                            seat:Sit(myHum)
                            task.wait(0.1)
                            waitCount = waitCount + 1
                        end
                        if not myHum.Sit then
                            game:GetService("StarterGui"):SetCore("SendNotification", {Title="Vehicle Fling", Text="Cannot sit!", Duration=3})
                            _G.VehicleFlingActive = false
                            _G.VehicleFlingCar = nil
                            if vehicleFlingToggleRef then pcall(function() vehicleFlingToggleRef:Set(false) end) end
                            return
                        end
                    end

                    vehicleFlingRunning = true

                    if myHum then
                        pcall(function() myHum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
                    end

                    game:GetService("StarterGui"):SetCore("SendNotification", {Title="FLING ACTIVE", Text="Orbite serree - impact centrifuge !", Duration=3})

                    -- Attack engine: FFAZF Orbital centrifuge (25k + Spin Y 8000)
                    local attackStart = tick()
                    vehicleFlingConnection = game:GetService("RunService").Heartbeat:Connect(function(dt)
                        if not vehicleFlingRunning or not myVehicle or not myVehicle.Parent then
                            if vehicleFlingConnection then vehicleFlingConnection:Disconnect() end
                            return
                        end
                        if not targetPlayer.Character then
                            task.spawn(function() stopVehicleFling(false, false) end)
                            return
                        end

                        local tHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                        local tHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                        local primary = myVehicle.PrimaryPart or getVehiclePart(myVehicle) or seat

                        if not tHrp or not primary then return end

                        -- Orbit serre a 2 studs = contact physique garanti chaque frame
                        local t = tick()
                        local r = 2
                        local ox = math.sin(t * 10) * r
                        local oz = math.cos(t * 10) * r

                        local targetCF = CFrame.new(
                            tHrp.Position + Vector3.new(ox, 0.5, oz),
                            tHrp.Position
                        )

                        pcall(function()
                            if myVehicle.PivotTo then
                                myVehicle:PivotTo(targetCF)
