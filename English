    })

    -- ============ ANTI VEHICLE FLING (protects vs ambulance/bus fling) ============
    local _antiVehicleSpeedRunning = false
    local function setAntiVehicleSpeed(state)
        _antiVehicleSpeedRunning = state
        if state then
            task.spawn(function()
                while _antiVehicleSpeedRunning do
                    local lpChar = LocalPlayer.Character
                    if lpChar then
                        local hrp = lpChar:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local vehiclesFolder = Workspace:FindFirstChild("Vehicles")
                            if vehiclesFolder then
                                for _, v in ipairs(vehiclesFolder:GetChildren()) do
                                    if isOurFlingVehicle(v) then continue end
                                    local primary = v.PrimaryPart
                                    if primary then
                                        local speed = primary.AssemblyLinearVelocity.Magnitude
                                        if speed > 50000 then
                                            local dist = (primary.Position - hrp.Position).Magnitude
                                            if dist < 50 then
                                                pcall(function() v:Destroy() end)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    task.wait(0.05)
                end
            end)
        end
    end
    _G.BTR_PROT_CALLBACKS.VehicleSpeed = setAntiVehicleSpeed
    _G.BTR_PROT_TOGGLES.VehicleSpeed = ProtectionTab:AddToggle({
        Name = "Anti Vehicle Fling",
        Description = "Detects vehicles flung at you >50000 studs/s and destroys them (skips your own)",
        Default = (_G.BTR_AUTORUN and _G.BTR_AUTORUN.VehicleSpeed == true) or false,
        Callback = function(state) _G.setBTRProtection("VehicleSpeed", state, "ProtectionTab") end
    })

    -- ============ ANTI BANG TOTAL (counter-attack) ============
    local _antiBangActive = false

    ProtectionTab:AddToggle({
        Name = "Anti-Bang (Total)",
        Description = "Detects any bang (CFrame loop, TP, or animation) and stops the attacker immediately",
        Default = false,
        Callback = function(state)
            _antiBangActive = state
            if state then
                task.spawn(function()
                    local lastPositions = {}
                    local suspiciousTicks = {}

                    local function counterAttack(attacker)
                        -- 1) Attacker goes to the void
                        local aChar = attacker and attacker.Character
                        local aHrp = aChar and aChar:FindFirstChild("HumanoidRootPart")
                        if aHrp then
                            pcall(function() aHrp.CFrame = CFrame.new(0, -90000, 0) end)
                            pcall(function() aHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
                        end
                        -- 2) Teleport ourselves slightly up and reset seat/physics
                        local myChar = LocalPlayer.Character
                        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        if myHrp then
                            pcall(function() myHrp.CFrame = myHrp.CFrame * CFrame.new(0, 8, -5) end)
                            task.wait(0.05)
                            pcall(function() myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
                        end
                        pcall(function()
                            local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                            if myHum then myHum.Sit = false end
                        end)
                        StarterGui:SetCore("SendNotification", {
                            Title = "Anti-Bang",
                            Text = "Bang detected from " .. (attacker and attacker.Name or "Player") .. "! Attack neutralized.",
                            Duration = 3
                        })
                    end

                    while _antiBangActive do
                        local myChar = LocalPlayer.Character
                        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        if myHrp then
                            for _, plr in ipairs(Players:GetPlayers()) do
                                if plr ~= LocalPlayer and plr.Character then
                                    local aChar = plr.Character
                                    local aHum = aChar:FindFirstChildOfClass("Humanoid")
                                    local aHrp = aChar:FindFirstChild("HumanoidRootPart")
                                    if aHum and aHrp then
                                        local dist = (aHrp.Position - myHrp.Position).Magnitude
                                        local last = lastPositions[plr]
                                        local tpJump = false
                                        if last then
                                            tpJump = (aHrp.Position - last).Magnitude > 25
                                        end
                                        lastPositions[plr] = aHrp.Position

                                        -- Check if attacker has active animations
                                        local animPlaying = #aHum:GetPlayingAnimationTracks() > 0

                                        -- Vector check: is he directly behind us?
                                        local toAttacker = (aHrp.Position - myHrp.Position).Unit
                                        local myLook = myHrp.CFrame.LookVector
                                        local isBehind = myLook:Dot(toAttacker) < -0.4

                                        -- Detection 1: CFrame Bang Loop (extremely close behind us < 3.5 studs + animating or jumping)
                                        if dist < 3.5 and (isBehind or animPlaying) then
                                            suspiciousTicks[plr] = (suspiciousTicks[plr] or 0) + 1
                                            if suspiciousTicks[plr] >= 2 then
                                                counterAttack(plr)
                                                suspiciousTicks[plr] = 0
                                                break
                                            end
                                        -- Detection 2: Fast TP Loop Bang (< 8 studs + tp jumps + animation)
                                        elseif dist < 8 and animPlaying and tpJump then
                                            counterAttack(plr)
                                            suspiciousTicks[plr] = 0
                                            break
                                        else
                                            suspiciousTicks[plr] = 0
                                        end
                                    end
                                end
                            end

                            -- Physics anti-fling safety
                            local vel = myHrp.AssemblyLinearVelocity
                            if vel.Magnitude > 4000 then
                                pcall(function() myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
                            end
                            if myHrp.Position.Y < -100 then
                                pcall(function() myHrp.CFrame = CFrame.new(myHrp.Position.X, 200, myHrp.Position.Z) end)
                            end
                        end
                        task.wait(0.1)
                    end
                    lastPositions = {}
                    suspiciousTicks = {}
                end)
            end
        end
    })

    -- ============ ANTI-AFK ============
    local function setAntiAfk(state)
