        local function executeFakeAdminAction(action, targetRaw, targetRaw2, senderPlayer)
            local Players = game:GetService("Players")
            local lp = Players.LocalPlayer

            local target = resolveTargetPlayer(targetRaw, senderPlayer, (action == "To" or action == "TpMulti" or action == "Bring"))
            if not target then
                safeAdminNotify("Fake Admin", "Target '" .. tostring(targetRaw) .. "' not found.", 2)
                return
            end

            -- Sécurité : Keito (LocalPlayer) ne peut pas être tué, gelé, exilé ou jeté de la falaise
            local isHarmful = (action == "Kill" or action == "Exile" or action == "Cliff" or action == "Freeze" or action == "Jail" or action == "JailV2")
            if isHarmful and target == lp then
                safeAdminNotify("Fake Admin", "Cannot use harmful action on script owner.", 2)
                return
            end

            -- Priorité absolue : stop tout bring ou admin précédent
            if BringSystem.Active then BringSystem.stop() end
            if adminRunning then adminStopAll() end
            task.wait(0.1)

            local actionDuration = (action == "Bring" or action == "To" or action == "TpMulti") and 10 or 20
            local currentActionSession = BringSystem.SessionId + 1

            task.spawn(function()
                task.wait(actionDuration)
                if BringSystem.Active and BringSystem.SessionId == currentActionSession then
                    BringSystem.stop()
                    pcall(function()
                        game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("1Clea1rTool1s"):FireServer("ClearAllProps")
                    end)
                end
            end)

            task.spawn(function()
                if action == "Kill" then
                    BringSystem.bringPlayer(target, "Kill", true, senderPlayer.Name)
                elseif action == "Bring" then
                    BringSystem.bringPlayer(target, "Bring", true, senderPlayer.Name)
                elseif action == "Jail" then
                    BringSystem.bringPlayer(target, "Jail", true, senderPlayer.Name)
                elseif action == "JailV2" then
                    BringSystem.bringPlayer(target, "JailV2", true, senderPlayer.Name)
                elseif action == "Freeze" then
                    BringSystem.bringPlayer(target, "Freeze", true, senderPlayer.Name)
                elseif action == "Exile" then
                    BringSystem.bringPlayer(target, "Exile", true, senderPlayer.Name)
                elseif action == "Cliff" then
                    BringSystem.bringPlayer(target, "Cliff", true, senderPlayer.Name)
                elseif action == "To" then
                    if senderPlayer and senderPlayer.Character then
                        BringSystem.bringPlayer(senderPlayer, "Bring", true, target.Name)
                    end
                elseif action == "TpMulti" then
                    local p1IsMe = (targetRaw:lower() == "me" or targetRaw:lower() == "myself")
                    local p2IsMe = (targetRaw2 and (targetRaw2:lower() == "me" or targetRaw2:lower() == "myself"))

                    if p1IsMe then
                        local dest = resolveTargetPlayer(targetRaw2, senderPlayer, true)
                        if dest and senderPlayer and senderPlayer.Character then
                            BringSystem.bringPlayer(senderPlayer, "Bring", true, dest.Name)
                        end
                    elseif p2IsMe then
                        BringSystem.bringPlayer(target, "Bring", true, senderPlayer.Name)
                    else
                        local target2 = resolveTargetPlayer(targetRaw2, senderPlayer, true)
                        if target2 then
                            BringSystem.bringPlayer(target, "Bring", true, target2.Name)
                        end
                    end
                end
            end)
        end

        local processedMessages = {}

        local function processIncomingChat(sender, rawText)
            if not sender or not rawText then return end
            local text = tostring(rawText):match("^%s*(.-)%s*$")
            if not text or text == "" then return end

            local now = os.clock()
            local msgKey = sender.Name .. ":" .. text
            if processedMessages[msgKey] and (now - processedMessages[msgKey] < 0.3) then
                return
            end
            processedMessages[msgKey] = now

            local Players = game:GetService("Players")
            local lp = Players.LocalPlayer

            -- 1. Commandes de Keito (Le Boss) dans le chat : :admin [joueur] et :unadmin
            if sender == lp then
                local adminArg = text:match("^[;:!/%.]?[aA][dD][mM][iI][nN]%s+(.+)$")
                if adminArg then
                    adminArg = adminArg:match("^%s*(.-)%s*$")
                    if adminArg and adminArg ~= "" then
                        local target = resolveTargetPlayer(adminArg, nil, true)
                        if target then
                            setFakeAdminState(target, true)
                        else
                            safeAdminNotify("Fake Admin", "Player '" .. tostring(adminArg) .. "' not found.", 2)
                        end
                    end
                    return
                elseif text:lower():match("^[;:!/%.]?[uU][nN][aA][dD][mM][iI][nN]") or text:lower() == ":unadmin" or text:lower() == "unadmin" then
                    setFakeAdminState(nil, false)
                    return
                end
            end

            -- 2. Vérification d'autorisation Fake Admin
            if not fakeAdminEnabled or not fakeAdminTarget or fakeAdminTarget == "---" then return end
            if sender.Name:lower() ~= fakeAdminTarget:lower() then return end

            -- Extraction tolérante de la commande (préfixes optionnels :, ;, !, /, .)
            local cmd, arg = text:match("^[;:!/%.]?%s*([%w_]+)%s*(.*)$")
            if not cmd then return end
            cmd = cmd:lower()
            arg = (arg and arg:match("^%s*(.-)%s*$")) or ""
            local lowerArg = arg:lower()

            -- Commande :cmds / :help
            if cmd == "cmds" or cmd == "help" or cmd == "commands" then
                if now - lastCmdsTime >= 4 then
                    lastCmdsTime = now
                    task.spawn(function()
                        sendSafeChatMessage("Commands: :bring [name], :kill [name], :jail [name], :freeze [name], :cliff [name], :exile [name], :to [name], :tp [p1] [p2], :stop")
                        task.wait(0.6)
                        sendSafeChatMessage("Mass: :bring all, :kill all, :freeze all, :void all")
                    end)
                end
                return
            end

            -- Commande :stop
            if cmd == "stop" or cmd == "cancel" or cmd == "unbring" then
                if BringSystem.Active then BringSystem.stop() end
                if adminRunning then adminStopAll() end
                pcall(function()
                    game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("1Clea1rTool1s"):FireServer("ClearAllProps")
                end)
                safeAdminNotify("Fake Admin", "Stopped all actions by " .. sender.DisplayName, 2)
                return
            end

            -- Détection "ALL"
            local isAll = (lowerArg == "all" or lowerArg == "everyone" or lowerArg == "all players" or lowerArg == "everybody" or lowerArg == "allplayers" or lowerArg == "others")

            -- Commandes Mass
            if cmd == "bringall" or (cmd == "bring" and isAll) or cmd == "pullall" or (cmd == "pull" and isAll) then
                task.spawn(function()
                    if BringSystem and BringSystem.Active then BringSystem.stop() end
                    if adminRunning then adminStopAll() end
                    task.wait(0.2)
                    runAdmin("Bring", nil, sender.Name)
                end)
                return
            elseif cmd == "killall" or (cmd == "kill" and isAll) then
                task.spawn(function()
                    if BringSystem and BringSystem.Active then BringSystem.stop() end
                    if adminRunning then adminStopAll() end
                    task.wait(0.2)
                    runAdmin("Kill", nil, sender.Name)
                end)
                return
            elseif cmd == "freezeall" or (cmd == "freeze" and isAll) then
                task.spawn(function()
                    if BringSystem and BringSystem.Active then BringSystem.stop() end
                    if adminRunning then adminStopAll() end
                    task.wait(0.2)
                    runAdmin("Freeze", nil, sender.Name)
                end)
                return
            elseif cmd == "voidall" or cmd == "exileall" or (cmd == "void" and isAll) or (cmd == "exile" and isAll) then
                task.spawn(function()
                    if BringSystem and BringSystem.Active then BringSystem.stop() end
                    if adminRunning then adminStopAll() end
                    task.wait(0.2)
                    runAdmin("Void", nil, sender.Name)
                end)
                return
            elseif cmd == "jailall" or (cmd == "jail" and isAll) then
                task.spawn(function()
                    if BringSystem and BringSystem.Active then BringSystem.stop() end
                    if adminRunning then adminStopAll() end
                    task.wait(0.2)
                    runAdmin("Jail", nil, sender.Name)
                end)
                return
            elseif cmd == "cliffall" or (cmd == "cliff" and isAll) then
                task.spawn(function()
                    if BringSystem and BringSystem.Active then BringSystem.stop() end
                    if adminRunning then adminStopAll() end
                    task.wait(0.2)
                    runAdmin("Cliff", nil, sender.Name)
                end)
                return
            end

            -- Commandes sur cible unique
            if arg and arg ~= "" then
                if cmd == "kill" then
                    executeFakeAdminAction("Kill", arg, nil, sender)
                elseif cmd == "bring" or cmd == "pull" then
                    executeFakeAdminAction("Bring", arg, nil, sender)
                elseif cmd == "jail" then
                    executeFakeAdminAction("Jail", arg, nil, sender)
                elseif cmd == "jailv2" then
                    executeFakeAdminAction("JailV2", arg, nil, sender)
                elseif cmd == "freeze" then
                    executeFakeAdminAction("Freeze", arg, nil, sender)
                elseif cmd == "cliff" then
                    executeFakeAdminAction("Cliff", arg, nil, sender)
                elseif cmd == "exile" or cmd == "void" then
                    executeFakeAdminAction("Exile", arg, nil, sender)
                elseif cmd == "to" or cmd == "goto" then
                    executeFakeAdminAction("To", arg, nil, sender)
                elseif cmd == "tp" or cmd == "teleport" then
                    local p1, p2 = arg:match("^([^%s]+)%s+(.+)$")
                    if p1 and p2 then
                        executeFakeAdminAction("TpMulti", p1, p2, sender)
                    else
                        executeFakeAdminAction("To", arg, nil, sender)
                    end
                end
            end
        end

        local function hookChatListeners()
            if _G.BTR_FakeAdminConns then
                for _, c in ipairs(_G.BTR_FakeAdminConns) do
