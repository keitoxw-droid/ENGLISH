    snd.Volume = 1
    snd:Play()
    game:GetService("Debris"):AddItem(snd, 3)
    playFENote(id)
end

local function playSheet(sheet, tempo)
    local beat = 60 / ((tempo or 200) * 4)
    local i = 1
    local myID = pianoPlayID
    while i <= #sheet and pianoPlaying and pianoPlayID == myID do
        local c = sheet:sub(i, i)
        if c == "[" then
            local close = sheet:find("]", i, true)
            if close then
                local group = sheet:sub(i+1, close-1)
                for ch in group:gmatch(".") do
                    if pianoPlayID ~= myID then break end
                    local note = KeysToNotes[ch]
                    if note then playNote(note) end
                    task.wait(0.05)
                end
                task.wait(beat)
                i = close
            end
        elseif c == " " or c == "\n" or c == "\r" then
            task.wait(beat)
        elseif c == "-" then
            task.wait(beat * 0.5)
        else
            local note = KeysToNotes[c]
            if note then playNote(note) end
            task.wait(beat)
        end
        i = i + 1
    end
    pianoPlaying = false
end

