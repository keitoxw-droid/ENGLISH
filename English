                            end
                        end
                    end

                    local t = tick() - t0
                    local propCount = math.max(#currentProps, 1)

                    for i, entry in pairs(currentProps) do
                        if not blindLoopRunning then break end
                        local targetCF

                        if mode == "V1" then
                            -- V1: Ring de base au sol/taille
                            local angle = (i / propCount) * (2 * math.pi)
                            local offset = Vector3.new(math.cos(angle) * 0.5, -2.5, math.sin(angle) * 0.5)
                            targetCF = CFrame.new(targetPos + offset)

                        elseif mode == "V2" then
                            -- V2: Cocon vertical
                            local angle = (i / propCount) * (2 * math.pi)
                            local yOffset = -2.5 + ((i - 1) / math.max(propCount - 1, 1)) * 4.0
                            local offset = Vector3.new(math.cos(angle) * 0.5, yOffset, math.sin(angle) * 0.5)
                            targetCF = CFrame.new(targetPos + offset)

                        elseif mode == "V3" then
                            -- V3: Sphère Orbitale 3D (Tesseract) - rotation dynamique 360 sur 3 axes
                            local phi = math.acos(-1 + (2 * (i - 1)) / propCount)
                            local theta = math.sqrt(propCount * math.pi) * phi + t * 4
                            local r = 2.8 -- Rayon optimal pour englober la tête et le champ de caméra
                            local x = r * math.sin(phi) * math.cos(theta)
                            local y = r * math.sin(phi) * math.sin(theta) + 0.5
                            local z = r * math.cos(phi)
                            targetCF = CFrame.new(targetPos + Vector3.new(x, y, z), targetPos + Vector3.new(0, 0.5, 0))

                        elseif mode == "V4" then
                            -- V4: Double Hélix Tornade - spirales entrelacées montantes et descendantes
                            local isSecondHelix = (i % 2 == 0)
                            local baseAngle = (i / propCount) * (4 * math.pi) + (isSecondHelix and (t * 5 + math.pi) or (-t * 5))
                            local yProgress = ((i - 1) / math.max(propCount - 1, 1)) * 5.0 - 2.0
                            local r = 2.2 + math.sin(t * 3 + yProgress) * 0.6
                            local offset = Vector3.new(math.cos(baseAngle) * r, yProgress, math.sin(baseAngle) * r)
                            targetCF = CFrame.new(targetPos + offset, targetPos + Vector3.new(0, yProgress, 0))

