                                end
                                table.insert(unicornParts, {key=bp.key, scf=scf, cpc=cpc, blueprint=bp, propModel=prop})
                                found = true
                                break
                            end
                        end
                    end
                end
            end
        end

        for _, _p in ipairs(unicornParts) do uStream:add(_p.scf, _p.cpc) end
        uStream:start()
        cleanupPropMakerTool()
