            local player = game:GetService("Players").LocalPlayer
            local char = player.Character
            if not char then DesyncActive = false return end
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not root or not hum then DesyncActive = false return end

            local frozenCF = root.CFrame

            pcall(function()
                DesyncGhostModel = char:Clone()
                DesyncGhostModel.Name = "DesyncGhost"
                for _, v in pairs(DesyncGhostModel:GetDescendants()) do
                    if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end
                    if v:IsA("BasePart") then v.Transparency = 0.6; v.CanCollide = false end
                end
                DesyncGhostModel.Parent = workspace
                if DesyncGhostModel:FindFirstChild("HumanoidRootPart") then
                    DesyncGhostModel.HumanoidRootPart.CFrame = frozenCF
                    DesyncGhostModel.HumanoidRootPart.Anchored = true
                end
            end)

            DesyncConnection = RS.Heartbeat:Connect(function()
                if not DesyncActive or not root or not root.Parent then return end
                local realCF = root.CFrame
                local origCamOff = hum.CameraOffset

                root.CFrame = frozenCF
                hum.CameraOffset = frozenCF:ToObjectSpace(CFrame.new(realCF.Position)).Position

                RS.RenderStepped:Wait()

                if DesyncActive and root and root.Parent then
                    root.CFrame = realCF
                    hum.CameraOffset = origCamOff
                end
            end)

            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Desync", Text = "Desync ON! Others see you at your ghost position.", Duration = 3
            })
        else
            stopDesync()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Desync", Text = "Desync OFF! Position resynced.", Duration = 3
            })
        end
    end
})



