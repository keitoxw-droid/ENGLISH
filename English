                            end
                            if sender then
                                processIncomingChat(sender, textContent)
                            end
                        end)
                        table.insert(_G.BTR_FakeAdminConns, conn)
                    end
                end
            end

            -- Legacy Chat listener (pour compatibilité maximale et fallback)
            for _, p in ipairs(Players:GetPlayers()) do
                local conn = p.Chatted:Connect(function(msg)
                    processIncomingChat(p, msg)
                end)
