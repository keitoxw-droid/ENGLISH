        end

        local function resolveTargetPlayer(rawName, excludedSender, allowSelf)
            if not rawName or rawName == "" then return nil end
            local Players = game:GetService("Players")
            local lp = Players.LocalPlayer
            local clean = rawName:lower():match("^%s*(.-)%s*$")
            if not clean or clean == "" then return nil end

            if clean == "me" or clean == "myself" then
                if excludedSender then return excludedSender end
                return lp
            end

            local function isExcluded(p)
                if not allowSelf and excludedSender and p == excludedSender then
                    return true
                end
                return false
            end

            local allPlayers = Players:GetPlayers()

            -- 1. Match pseudo exact (insensible à la casse)
            for _, p in ipairs(allPlayers) do
                if not isExcluded(p) and p.Name:lower() == clean then
                    return p
                end
            end

            -- 2. Match DisplayName exact (insensible à la casse)
            for _, p in ipairs(allPlayers) do
                if not isExcluded(p) and p.DisplayName:lower() == clean then
                    return p
                end
            end

            -- 3. Match début de pseudo
            for _, p in ipairs(allPlayers) do
                if not isExcluded(p) and p.Name:lower():sub(1, #clean) == clean then
                    return p
                end
            end

            -- 4. Match début de DisplayName
            for _, p in ipairs(allPlayers) do
                if not isExcluded(p) and p.DisplayName:lower():sub(1, #clean) == clean then
                    return p
                end
            end

            -- 5. Match sous-chaîne dans le pseudo
            for _, p in ipairs(allPlayers) do
                if not isExcluded(p) and p.Name:lower():find(clean, 1, true) then
                    return p
                end
            end

            -- 6. Match sous-chaîne dans le DisplayName
            for _, p in ipairs(allPlayers) do
                if not isExcluded(p) and p.DisplayName:lower():find(clean, 1, true) then
                    return p
                end
            end

            return nil
        end

