-- Anti-Lag avec restauration des graphismes
local _savedGraphics = {}
local _antiLagActive = false
SettingsTab:AddToggle({
    Name = "Anti-Lag (FPS Boost)",
    Description = "Boosts FPS by simplifying textures (restores on toggle OFF)",
    Default = false,
    Callback = function(state)
        _antiLagActive = state
        local Lighting = game:GetService("Lighting")
        local Terrain = workspace:FindFirstChildOfClass("Terrain")

        if state then
            -- Sauvegarde de l'état original
            _savedGraphics = {
                GlobalShadows = Lighting.GlobalShadows,
                FogEnd = Lighting.FogEnd,
                Brightness = Lighting.Brightness,
                TerrainWaterWaveSize = Terrain and Terrain.WaterWaveSize or 0,
                Parts = {}
            }

            pcall(function()
                Lighting.GlobalShadows = false
                Lighting.FogEnd = 9e9
                if Terrain then Terrain.WaterWaveSize = 0 end
            end)

            for _, obj in ipairs(workspace:GetDescendants()) do
                pcall(function()
                    if obj:IsA("BasePart") and not obj.Parent:FindFirstChildOfClass("Humanoid") then
                        _savedGraphics.Parts[obj] = {
                            Material = obj.Material,
                            CastShadow = obj.CastShadow
                        }
                        obj.Material = Enum.Material.SmoothPlastic
                        obj.CastShadow = false
                    elseif obj:IsA("Decal") or obj:IsA("Texture") then
                        _savedGraphics.Parts[obj] = { Transparency = obj.Transparency }
                        obj.Transparency = 0.8
                    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") then
                        _savedGraphics.Parts[obj] = { Enabled = obj.Enabled }
                        obj.Enabled = false
                    end
                end)
            end
        else
            -- Restauration complète des graphismes
            pcall(function()
                if _savedGraphics.GlobalShadows ~= nil then Lighting.GlobalShadows = _savedGraphics.GlobalShadows end
                if _savedGraphics.FogEnd ~= nil then Lighting.FogEnd = _savedGraphics.FogEnd end
                if _savedGraphics.Brightness ~= nil then Lighting.Brightness = _savedGraphics.Brightness end
                if Terrain and _savedGraphics.TerrainWaterWaveSize ~= nil then Terrain.WaterWaveSize = _savedGraphics.TerrainWaterWaveSize end
            end)

            for obj, props in pairs(_savedGraphics.Parts or {}) do
                pcall(function()
                    if obj and obj.Parent then
                        if props.Material ~= nil then obj.Material = props.Material end
                        if props.CastShadow ~= nil then obj.CastShadow = props.CastShadow end
                        if props.Transparency ~= nil then obj.Transparency = props.Transparency end
                        if props.Enabled ~= nil then obj.Enabled = props.Enabled end
                    end
                end)
            end
            _savedGraphics = {}
        end
    end
})

