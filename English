do
    local bleacherFlyRunning = false

    local function cleanupSkyLift()
        local RE = game:GetService("ReplicatedStorage"):FindFirstChild("RE")
        if RE then
            local clearTools = RE:FindFirstChild("1Clea1rTool1s")
            if clearTools then
                -- Toggle OFF => ClearAllProps + ClearAllTools (remove PropMaker too)
                pcall(function() clearTools:FireServer("ClearAllProps") end)
                task.wait(0.1)
                pcall(function() clearTools:FireServer("ClearAllTools") end)
                task.wait(0.1)
            end
        end
        cleanupPropMakerTool()
    end

    TrollTab:AddToggle({
        Name = "Bleacher Sky Lift (Troll Fly)",
        Description = "Carries the target into the sky on a bleacher platform!",
        Default = false,
        Callback = function(state)
            if not _G.BTR_UI_READY then return end
            bleacherFlyRunning = state
            if state then
                local targetPlayer = nil
                if _G.TrollTarget and _G.TrollTarget ~= "---" then
                    targetPlayer = game:GetService("Players"):FindFirstChild(_G.TrollTarget)
                end

                if not targetPlayer then
                    game:GetService("StarterGui"):SetCore("SendNotification", {Title="Sky Lift", Text="Player not found!", Duration=3})
                    bleacherFlyRunning = false
                    return
                end

                task.spawn(function()
                    local lp = game:GetService("Players").LocalPlayer
                    local RE = game:GetService("ReplicatedStorage"):WaitForChild("RE")
                    local clearTools = RE:WaitForChild("1Clea1rTool1s")
                    local myPropName = "Prop" .. lp.Name

                    pcall(function() clearTools:FireServer("ClearAllProps") end)
                    task.wait(0.15)

                    local propsTool = getOrFetchPropMaker()
                    if not propsTool then bleacherFlyRunning = false return end

                    pcall(function() clearTools:FireServer("OpenPropMenu") end)
                    task.wait(0.05)

                    local knownScf = {}
                    for _, folder in pairs(workspace:WaitForChild("WorkspaceCom"):GetChildren()) do
                        for _, prop in pairs(folder:GetChildren()) do
                            if prop.Name == myPropName then
                                local scf = prop:FindFirstChild("SetCurrentCFrame")
                                if scf then knownScf[scf] = true end
                            end
                        end
                    end

                    -- Select Bleachers
                    pcall(function() clearTools:FireServer("RequestingPropName", "FurnitureBleachers", "Furniture") end)
                    task.wait(0.25)

                    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                    local spawnPos = myRoot and myRoot.Position or Vector3.new(0, 10, 0)
                    local toolPropMake = propsTool:FindFirstChild("Tool_PropMake") or propsTool:WaitForChild("Tool_PropMake", 3)
                    if not toolPropMake then bleacherFlyRunning = false return end

                    -- Spawn 15 bleachers (0.85s cooldown per prop)
                    local flyScfs = {}
                    for i = 1, 15 do
                        if not bleacherFlyRunning then break end
                        pcall(function() toolPropMake:FireServer(workspace.Terrain, spawnPos) end)
                        task.wait(0.85)
                        for _, folder in pairs(workspace:WaitForChild("WorkspaceCom"):GetChildren()) do
                            for _, prop in pairs(folder:GetChildren()) do
                                if prop.Name == "Prop" .. lp.Name then
                                    local scf = prop:FindFirstChild("SetCurrentCFrame")
                                    if scf and not knownScf[scf] then
                                        knownScf[scf] = true
                                        table.insert(flyScfs, scf)
                                        break
                                    end
                                end
                            end
                        end
                    end

                    -- [PropMaker rule] Remove cardboard after placing (ClearAllTools removes the tool)
                    task.wait(1)
                    pcall(function() clearTools:FireServer("ClearAllTools") end)
                    task.wait(0.1)
                    local hNow = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
                    if hNow then pcall(function() hNow:UnequipTools() end) end
                    pcall(function() clearTools:FireServer("ClosePropMenu") end)
                    cleanupPropMakerTool()

                    if #flyScfs == 0 then
                        bleacherFlyRunning = false
                        return
                    end

                    -- Platform offsets (15 bleachers under the target)
                    local platformOffsets = {
                        Vector3.new(0, 0, 0),
                        Vector3.new(2.5, 0, 0),
                        Vector3.new(-2.5, 0, 0),
                        Vector3.new(0, 0, 2.5),
                        Vector3.new(0, 0, -2.5),
                        Vector3.new(5, 0, 0),
                        Vector3.new(-5, 0, 0),
                        Vector3.new(0, 0, 5),
                        Vector3.new(0, 0, -5),
                        Vector3.new(3.5, 0, 3.5),
                        Vector3.new(-3.5, 0, 3.5),
                        Vector3.new(3.5, 0, -3.5),
                        Vector3.new(-3.5, 0, -3.5),
                        Vector3.new(5, 0, 2.5),
                        Vector3.new(-5, 0, -2.5),
                    }

                    local tHrpRef = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local platformTargetY = tHrpRef and (tHrpRef.Position.Y - 1.5) or (spawnPos.Y - 1.5)

                    -- [FIX NETWORK] Coalescence Bleacher Fly : évite 300 req/s
                    local lastFlyPos = {} -- scf -> Vector3
                    local lastFlyTime = {} -- scf -> os.clock()
                    local FLY_MOVE_THRESHOLD = 0.5
                    local FLY_MIN_INTERVAL = 0.1
                    local FLY_MAX_INTERVAL = 0.25
                    local currentLiftY = nil
                    local captured = false

                    while bleacherFlyRunning do
                        if targetPlayer and targetPlayer.Character then
                            local tHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                            local tHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                            if tHrp then
                                if not currentLiftY then
                                    currentLiftY = tHrp.Position.Y - 1.2
                                end

                                -- Vérifie si le joueur est assis sur le gradin
                                if tHum and tHum.Sit and tHum.SeatPart and tHum.SeatPart:FindFirstAncestor(myPropName) then
                                    captured = true
                                end

                                -- Si capturé (ou après 1.5s), monte sans fin dans le ciel à grande vitesse
                                currentLiftY = currentLiftY + 1.2
                                local basePos = Vector3.new(tHrp.Position.X, currentLiftY, tHrp.Position.Z)
                                local now = os.clock()

                                for idx, scf in ipairs(flyScfs) do
                                    local off = platformOffsets[idx] or Vector3.new(0, 0, 0)
                                    local targetCF = CFrame.new(basePos + off)
                                    pcall(function() scf:InvokeServer(targetCF) end)
                                end
                            end
                        end
                        task.wait(0.04)
                    end
                end)
            else
                bleacherFlyRunning = false
                cleanupSkyLift()
            end
        end
    })
end

