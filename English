-- [LOCKED: WORK PERFECTLY] Helper Anti-Sit pour Carjack/Remove Free
-- Desactive le toggle Anti-Sit si actif, execute l'action, puis le reactive
-- IMPORTANT: en RedzLib, Toggle:Set(false) ne declenche PAS le Callback,
-- donc on force aussi _G.AntiSitValue + on restaure l'etat Seated manuellement.
local function withAntiSitDisabled(action)
    -- [FIX Keito v6] ATTENDRE que le module anti-sit soit charge:
    -- le wrapper est defini en haut du fichier, mais _G.AntiSitForceOff
    -- n'est expose qu'a la ligne ~8060. Au 1er appel il n'existe pas
    -- encore => fallback Toggle:Set(false) qui ne coupe RIEN (bug du
    -- "ca marche du 2eme coup"). [FIX v7] On attend max 10s, et si le
    -- module n'est pas encore la, le fallback force AntiSitValue + Seated.
    if not _G.AntiSitForceOff then
        local waited = 0
        while not _G.AntiSitForceOff and waited < 10 do
            task.wait(0.1)
            waited = waited + 0.1
        end
    end

    -- [FIX Keito v7] Source de verite fiable: _G.AntiSitValue (bool pur).
    -- Toggle.Value peut etre nil => le wrapper ne coupait RIEN et il
    -- fallait couper l'anti-sit a la main. On se base sur l'etat interne.
    local wasActive = (_G.AntiSitValue == true)
    if wasActive then
        -- VRAI off: coupe les connections (pas juste Toggle:Set qui ne fire pas le Callback)
        if _G.AntiSitForceOff then
            pcall(function() _G.AntiSitForceOff() end)
        else
            -- Fallback si le module anti-sit n'est pas encore expose:
            -- on force l'etat interne + l'UI + on re-active Seated direct
            _G.AntiSitValue = false
            pcall(function() _G.AntiSitToggle:Set(false) end)
            local lpChar = game.Players.LocalPlayer.Character
            local humFb = lpChar and lpChar:FindFirstChildOfClass("Humanoid")
            if humFb then
                pcall(function() humFb:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
            end
        end
        task.wait(0.05)
    end

    -- Pendant toute l'action, le heartbeat Anti-Sit laisse s'asseoir
    -- (même mécanisme que le Vehicle Fling existant)
    local prevFling = _G.VehicleFlingActive
    _G.VehicleFlingActive = true
    local ok, err = pcall(action)
    _G.VehicleFlingActive = prevFling or false

    -- [LOCKED Keito] SAUT FORCÉ pour sortir du véhicule AVANT de réactiver l'Anti-Sit
    -- (si on ne saute pas, on reste assis dans le véhicule)
    local lpChar = game.Players.LocalPlayer.Character
    local humOut = lpChar and lpChar:FindFirstChildOfClass("Humanoid")
    local hrpOut = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    if humOut then
        pcall(function() humOut.Sit = false end)
        -- GettingUp = état de sortie du siège reconnu par Roblox
        pcall(function() humOut:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        pcall(function() humOut.Jump = true end)
        if hrpOut then
            pcall(function()
                hrpOut.AssemblyLinearVelocity = Vector3.new(0, 60, 0)
                hrpOut.Velocity = Vector3.new(0, 60, 0)
            end)
        end
        task.wait(0.05)
        pcall(function() humOut.Jump = false end)
    end

    if wasActive then
        -- VRAI on: recrée les connections anti-sit
        if _G.AntiSitForceOn then
            pcall(function() _G.AntiSitForceOn() end)
        elseif _G.AntiSitToggle then
            pcall(function() _G.AntiSitToggle:Set(true) end)
            _G.AntiSitValue = true
        end
    end
    return ok, err
end
_G.withAntiSitDisabled = withAntiSitDisabled
