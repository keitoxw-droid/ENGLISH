-- Ticker léger de mise à jour des stats (FPS, Ping, Session Time) toutes les 2 secondes
task.spawn(function()
    local Stats = game:GetService("Stats")
    local sessionStart = tick()
    local lastTime = tick()
    local frameCount = 0
    local fps = 60

    game:GetService("RunService").RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        if now - lastTime >= 1 then
            fps = frameCount
            frameCount = 0
            lastTime = now
        end
    end)

    while true do
        task.wait(2)
        pcall(function()
            if not _perfParagraph then return end
            local ping = 0
            local pingStat = Stats:FindFirstChild("PerformanceStats") and Stats.PerformanceStats:FindFirstChild("Ping")
            if pingStat then
                ping = math.floor(pingStat:GetValue())
            else
                local netStat = Stats:FindFirstChild("Network") and Stats.Network:FindFirstChild("ServerStatsItem") and Stats.Network.ServerStatsItem:FindFirstChild("Data Ping")
                if netStat then
                    ping = math.floor(netStat:GetValue())
                end
            end

            local uptime = math.floor(tick() - sessionStart)
            local hours = math.floor(uptime / 3600)
            local mins = math.floor((uptime % 3600) / 60)
            local secs = uptime % 60
            local timeStr = string.format("%02dh %02dm %02ds", hours, mins, secs)

            local statusText = string.format("• FPS : %d fps\n• Ping : %d ms\n• Session Time : %s", fps, ping, timeStr)
            if _perfParagraph.Set then
                _perfParagraph:Set("Live Stats", statusText)
            elseif _perfParagraph.SetDesc then
                _perfParagraph:SetDesc(statusText)
            end
        end)
    end
end)

