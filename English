-- ============================================================
-- [LOCKED: WORK PERFECTLY] PIRATE SHIP TORNADO - VRAI CODE GOAT HUB
-- Source: GOAT HUB.txt (Drip Client Desofuscado) lignes 1598-1745
-- Remplace notre ancienne version "pourrave" (qui attendait que le
-- bateau tourne tout seul sans forcer la rotation).
-- Mecanisme reel: spawn PirateFree -> s'asseoir -> Flip loop sur
-- 1Player1sCa1r + Heartbeat avec waypoints autour de la place et
-- rotation 720 degres/s -> auto-off apres 5s -> DeleteAllVehicles.
-- ============================================================
do
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer

    local ShipSystem = {
        tornadoActive = false,
        currentShip = nil,
        antiSitWasActive = false,
        prevFling = false,
        tornadoSession = 0
    }

    local function spawnPirateShip()
        local character = LocalPlayer.Character
        if not character then return nil end

        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return nil end

        humanoidRootPart.CFrame = CFrame.new(1754, -2, 58)
        task.wait(0.5)

        local re = ReplicatedStorage:WaitForChild("RE")
        re:FindFirstChild("1Ca1r"):FireServer("PickingBoat", "PirateFree")
        task.wait(1)

        local vehicles = workspace:WaitForChild("Vehicles")
        return vehicles:FindFirstChild(LocalPlayer.Name .. "Car")
    end

    local function playShipAudio()
        local audioID = 9068077052
        local args = {workspace, audioID, 1}

        for i = 1, 5 do
            local re = ReplicatedStorage.RE:FindFirstChild("1Gu1nSound1s")
            if re then
                re:FireServer(unpack(args))
            end

            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local sound = Instance.new("Sound")
                sound.SoundId = "rbxassetid://" .. audioID
                sound.Parent = LocalPlayer.Character.HumanoidRootPart
                sound:Play()

                task.wait(1.5)
                sound:Destroy()
            end
        end
    end

    local function startTornado()
        -- [LOCKED: WORK PERFECTLY] SYSTEME ANTI-SIT v2 (pattern EXACT de withAntiSitDisabled)
        -- Source de verite: _G.AntiSitValue (bool pur, pas Toggle.Value qui peut etre nil).
        -- On coupe AVANT le spawn, on re-active UNIQUEMENT une fois descendu
        -- (task.delay ci-dessous) ou si stopTornado est appele.
        -- Fallback manuel si le module n'est pas expose (meme garde que le wrapper).
        ShipSystem.antiSitWasActive = (_G.AntiSitValue == true)

        -- [LOCKED Keito v4] SESSION ID: chaque startTornado incremente la session.
        -- stopTornado l'incremente AUSSI => tout task.delay en attente d'une
        -- ancienne session est annule (fix: toggle OFF rapide qui continuait
        -- l'action avec l'anti-sit deja reactive).
        ShipSystem.tornadoSession = ShipSystem.tornadoSession + 1
        local tornadoSession = ShipSystem.tornadoSession

        -- Attendre que le module anti-sit soit expose (meme garde que withAntiSitDisabled)
        if not _G.AntiSitForceOff then
            local waited = 0
            while not _G.AntiSitForceOff and waited < 10 do
                task.wait(0.1)
                waited = waited + 0.1
            end
        end

        local function restoreAntiSit()
            -- [LOCKED v3] On remet le flag VehicleFling AVANT de reactiver l'anti-sit
            _G.VehicleFlingActive = ShipSystem.prevFling or false
            if ShipSystem.antiSitWasActive then
                if _G.AntiSitForceOn then
                    pcall(function() _G.AntiSitForceOn() end)
                elseif _G.AntiSitToggle then
                    pcall(function() _G.AntiSitToggle:Set(true) end)
                    _G.AntiSitValue = true
                end
                ShipSystem.antiSitWasActive = false
            end
        end

        -- VRAI off: coupe les connections (comme le wrapper). Fallback manuel sinon.
        if _G.AntiSitForceOff then
            pcall(function() _G.AntiSitForceOff() end)
        else
            _G.AntiSitValue = false
            if _G.AntiSitToggle then
                pcall(function() _G.AntiSitToggle:Set(false) end)
            end
            local lpChar = game.Players.LocalPlayer.Character
            local humFb = lpChar and lpChar:FindFirstChildOfClass("Humanoid")
            if humFb then
                pcall(function() humFb:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
            end
        end
        -- [FIX v2] Laisse un tick au heartbeat pour qu'il voie _G.AntiSitValue = false
        task.wait(0.05)

        -- [LOCKED v3] Pendant toute la tornade, on met VehicleFlingActive = true
        -- (meme mecanisme que withAntiSitDisabled) : si un systeme re-active
        -- l'anti-sit en cours de route, le heartbeat laisse quand meme s'asseoir.
        ShipSystem.prevFling = _G.VehicleFlingActive
        _G.VehicleFlingActive = true

        ShipSystem.currentShip = spawnPirateShip()
        if not ShipSystem.currentShip then restoreAntiSit() return end

        local seat = ShipSystem.currentShip:FindFirstChild("Body")
        seat = seat and seat:FindFirstChild("VehicleSeat")
        if not seat then restoreAntiSit() return end

        local character = LocalPlayer.Character
        local humanoid = character:FindFirstChild("Humanoid")
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")

        if not humanoid or not humanoidRootPart then restoreAntiSit() return end

        repeat
            task.wait(0.1)
            humanoidRootPart.CFrame = seat.CFrame * CFrame.new(0, 1, 0)
        until humanoid.SeatPart == seat

        -- [LOCKED Keito v4] Si un stop/restart a eu lieu pendant qu'on attendait
        -- de s'asseoir => abandon silencieux (plus aucune action ensuite).
        if tornadoSession ~= ShipSystem.tornadoSession then
            return
        end

        task.spawn(playShipAudio)

        task.delay(4, function()
            -- [LOCKED Keito v4] Annule si la tornade a ete stoppee entre-temps
            if tornadoSession ~= ShipSystem.tornadoSession then return end
            if humanoid.SeatPart then
                humanoid.Sit = false
            end
            -- [LOCKED Keito] SAUT FORCE pour sortir du vehicule AVANT de reactiver
            -- l'Anti-Sit (meme mecanisme que withAntiSitDisabled - sinon on reste assis)
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            pcall(function() humanoid.Jump = true end)
            if humanoidRootPart then
                pcall(function()
                    humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 60, 0)
                    humanoidRootPart.Velocity = Vector3.new(0, 60, 0)
                end)
            end
            task.wait(0.05)
            pcall(function() humanoid.Jump = false end)
            humanoidRootPart.CFrame = CFrame.new(0, 5, 0)
            -- [LOCKED] Re-activation de l'Anti-Sit UNIQUEMENT une fois descendu
            restoreAntiSit()
        end)

        ShipSystem.tornadoActive = true

        task.spawn(function()
            local re = ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Player1sCa1r")
            while ShipSystem.tornadoActive and ShipSystem.currentShip and ShipSystem.currentShip.Parent do
                re:FireServer("Flip")
                task.wait(0.5)
            end
        end)

        local waypoints = {
            Vector3.new(-16, 0, -47),
            Vector3.new(-110, 0, -45),
            Vector3.new(16, 0, -55)
        }

        local currentIndex = 1
        local nextIndex = 2
        local moveSpeed = 30
        local rotationSpeed = math.rad(720)
        local progress = 0
        local currentRotation = 0

        local connection
        connection = RunService.Heartbeat:Connect(function(dt)
            if not ShipSystem.tornadoActive or not ShipSystem.currentShip or not ShipSystem.currentShip.PrimaryPart then
                connection:Disconnect()
                return
            end

            local startPos = waypoints[currentIndex]
            local endPos = waypoints[nextIndex]

            progress = progress + (moveSpeed * dt) / (startPos - endPos).Magnitude
            if progress >= 1 then
                progress = 0
                currentIndex = nextIndex
                nextIndex = (nextIndex % #waypoints) + 1
            end

            local newPos = startPos:lerp(endPos, progress)
            currentRotation = currentRotation + rotationSpeed * dt

            local cframe = CFrame.new(newPos) * CFrame.Angles(0, currentRotation, 0)
            ShipSystem.currentShip:SetPrimaryPartCFrame(cframe)
        end)
    end

    local function stopTornado()
        ShipSystem.tornadoActive = false
        -- [LOCKED Keito v4] Invalide tous les task.delay en attente (toggle OFF rapide)
        ShipSystem.tornadoSession = ShipSystem.tornadoSession + 1

        -- [LOCKED v3] On remet le flag VehicleFling AVANT de reactiver l'anti-sit
        _G.VehicleFlingActive = ShipSystem.prevFling or false

        -- [LOCKED] Si la tornade est coupee manuellement, re-activer l'Anti-Sit
        -- (avec fallback manuel comme le wrapper)
        if ShipSystem.antiSitWasActive then
            if _G.AntiSitForceOn then
                pcall(function() _G.AntiSitForceOn() end)
            elseif _G.AntiSitToggle then
                pcall(function() _G.AntiSitToggle:Set(true) end)
                _G.AntiSitValue = true
            end
            ShipSystem.antiSitWasActive = false
        end

        task.spawn(function()
            local args = {"DeleteAllVehicles"}
            local re = ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Ca1r")
            re:FireServer(unpack(args))
        end)
    end

    local TornadoToggle = VehicleTab:AddToggle({
        Name = "Pirate Ship Tornado",
        Description = "Pulls Pirate Ship to the Square",
        Default = false
    })

    TornadoToggle:Callback(function(Value)
        if Value then
            startTornado()
            task.wait(5)
            TornadoToggle:SetValue(false)
        else
            stopTornado()
        end
    end)
end
