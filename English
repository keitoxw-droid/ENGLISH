    local function getFoldedAnim(bpKey, t2)
        -- Animation quand la licorne est allongee au sol
        if bpKey:sub(1,5) == "patte" then
            if bpKey:sub(7,8) == "av" then
                return CFrame.Angles(math.rad(70), 0, 0)
            else
                return CFrame.Angles(math.rad(-70), 0, 0)
            end
        elseif bpKey:sub(1,4) == "aile" then
            return CFrame.Angles(0, 0, 0)
        elseif bpKey:sub(1,3) == "cou" or bpKey == "tete" or bpKey == "corne" or bpKey == "oeil" then
            return CFrame.new(0, math.sin(t2*2)*0.2 - 2, 0)
        else
            return CFrame.new(0, math.sin(t2*2)*0.2 - 3, 0)
        end
    end

