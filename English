    })

    -- ============ ANTI-COPY AVATAR ============
    ProtectionTab:AddSection({"》 Anti-Copy Avatar"})

    local _antiCopyActive = false
    local _notifiedCopyPlayers = {}
    local _baselinePlayerAssets = {}
    local _isRejoiningServer = false

    local function loadSlotOutfit(slotNum)
        pcall(function()
            local RS = game:GetService("ReplicatedStorage")
            local remotes = RS:FindFirstChild("Remotes")
            local loadOutfit = remotes and remotes:FindFirstChild("LoadOutfit")
            if loadOutfit then
                loadOutfit:InvokeServer(tonumber(slotNum) or 1)
            end
        end)
    end

    local function getPlayerAssetIds(char)
        local ids = {}
        if not char then return ids end
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Accessory") then
                local handle = c:FindFirstChild("Handle")
                if handle then
                    local sm = handle:FindFirstChildOfClass("SpecialMesh") or handle:FindFirstChildOfClass("FileMesh")
                    local meshId = sm and sm.MeshId or (handle:IsA("MeshPart") and handle.MeshId or "")
                    local num = meshId:match("%d+")
                    if num and #num > 4 then
                        ids["acc_" .. num] = true
                    elseif c.Name ~= "Accessory" and #c.Name > 3 then
                        ids["acc_name_" .. c.Name:lower()] = true
                    end
                end
            elseif c:IsA("Shirt") and c.ShirtTemplate ~= "" then
                local num = c.ShirtTemplate:match("%d+")
                if num and #num > 4 then ids["shirt_" .. num] = true end
            elseif c:IsA("Pants") and c.PantsTemplate ~= "" then
                local num = c.PantsTemplate:match("%d+")
                if num and #num > 4 then ids["pants_" .. num] = true end
            elseif c:IsA("ShirtGraphic") and c.Graphic ~= "" then
                local num = c.Graphic:match("%d+")
                if num and #num > 4 then ids["tshirt_" .. num] = true end
            end
        end
        return ids
    end

    local function setAntiCopy(state)
        _antiCopyActive = state
        _notifiedCopyPlayers = {}
        _baselinePlayerAssets = {}
        if state then
            task.spawn(function()
                -- Attendre 4 secondes au boot pour enregistrer l'état initial sans faux positif
                task.wait(4)

                -- Snapshot initial des joueurs déjà présents
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        _baselinePlayerAssets[plr.UserId] = getPlayerAssetIds(plr.Character)
                    end
                end

                while _antiCopyActive and not _isRejoiningServer do
                    local lpChar = LocalPlayer.Character
                    if lpChar then
                        local myIds = getPlayerAssetIds(lpChar)
                        local myCount = 0
                        for _ in pairs(myIds) do myCount = myCount + 1 end

                        if myCount >= 3 then
                            for _, plr in ipairs(Players:GetPlayers()) do
                                if plr ~= LocalPlayer and plr.Character and not _notifiedCopyPlayers[plr.UserId] then
                                    local currentIds = getPlayerAssetIds(plr.Character)
                                    local baseline = _baselinePlayerAssets[plr.UserId]

                                    if not baseline then
                                        -- Joueur qui vient d'entrer ou de spawn : on enregistre sa baseline
                                        _baselinePlayerAssets[plr.UserId] = currentIds
                                    else
                                        -- On compte combien de NOUVEAUX items équipés correspondent à notre avatar
                                        local newlyEquippedMatches = 0
                                        local totalMatches = 0
                                        for id in pairs(currentIds) do
                                            if myIds[id] then
                                                totalMatches = totalMatches + 1
                                                if not baseline[id] then
                                                    newlyEquippedMatches = newlyEquippedMatches + 1
                                                end
                                            end
                                        end

                                        -- Si le joueur vient d'équiper 3+ nouveaux items de notre skin en direct
                                        if newlyEquippedMatches >= 3 then
                                            _notifiedCopyPlayers[plr.UserId] = true
                                            _baselinePlayerAssets[plr.UserId] = currentIds

                                            StarterGui:SetCore("SendNotification", {
                                                Title = "Anti-Copy Alert!",
                                                Text = plr.Name .. " is copying your avatar!",
                                                Duration = 4
                                            })

                                            local reaction = _G.BTR_ANTI_COPY_REACTION or "Load Saved Slot Outfit"
                                            local slot = _G.BTR_OUTFIT_SLOT or 1

                                            if reaction == "Load Saved Slot Outfit" then
                                                loadSlotOutfit(slot)
                                                StarterGui:SetCore("SendNotification", {
                                                    Title = "Anti-Copy",
                                                    Text = "Loaded Slot " .. tostring(slot) .. " Outfit instantly!",
                                                    Duration = 3
                                                })
                                            elseif reaction == "Auto Rejoin" then
                                                _isRejoiningServer = true
                                                StarterGui:SetCore("SendNotification", {
                                                    Title = "Anti-Copy",
                                                    Text = "Copycat detected! Rejoining server...",
                                                    Duration = 3
                                                })
                                                task.wait(0.3)
                                                pcall(function()
                                                    local TS = game:GetService("TeleportService")
                                                    local Players = game:GetService("Players")
                                                    if #Players:GetPlayers() <= 1 then
                                                        Players.LocalPlayer:Kick("\nRejoining...")
                                                        task.wait()
                                                        TS:Teleport(game.PlaceId, Players.LocalPlayer)
                                                    else
                                                        TS:TeleportToPlaceInstance(game.PlaceId, game.JobId, Players.LocalPlayer)
                                                    end
                                                end)
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    task.wait(1)
                end
            end)
        end
    end

    _G.BTR_PROT_CALLBACKS.AntiCopy = setAntiCopy
    _G.BTR_PROT_TOGGLES.AntiCopy = ProtectionTab:AddToggle({
        Name = "Anti-Copy Avatar",
        Description = "Detects players copying 3+ of your items and reacts immediately",
