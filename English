        end

        local rideState = "resting"

        local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        local spawnOrigin = myRoot and myRoot.CFrame or CFrame.new(0,5,0)
        spawnOrigin = CFrame.new(spawnOrigin.Position) * CFrame.Angles(0, math.rad(90), 0)

        local currentVelocity = 0
        local creatureWorldPos = spawnOrigin.Position
        local currentYaw = 0
        local currentPitch = 0
        local currentBank = 0

        creatureLoop = RS.RenderStepped:Connect(function(dt)
            if not creatureActive then return end
            local _now = tick()
            if _now - lastUpdate < (1/24) then return end
            lastUpdate = _now

            t = t + dt
            local creatureCF
            creatureCF = spawnOrigin * CFrame.new(0, 1, 0)

            if rideState == "resting" then
                if isDriverSitting() then
                    setupCreatureGUI()
                    pcall(function() lp.Character:FindFirstChildOfClass("Humanoid"):SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end)
                    rideState = "manual_ground"
                    local _, yaw, _ = spawnOrigin:ToEulerAnglesYXZ()
                    currentYaw = yaw
                    currentPitch = 0; currentBank = 0; currentVelocity = 0
                    creatureWorldPos = creatureCF.Position
                    cNotif("Mythic Creature tamed! WASD = Move, Shift = Sprint, Space = Fly 🚀", 6)
                elseif isAnyoneSitting() then
                    rideState = "waiting"
                end

            elseif rideState == "waiting" then
                if isDriverSitting() then
                    setupCreatureGUI()
                    pcall(function() lp.Character:FindFirstChildOfClass("Humanoid"):SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end)
                    rideState = "manual_ground"
                    local _, yaw, _ = spawnOrigin:ToEulerAnglesYXZ()
                    currentYaw = yaw
                    currentPitch = 0; currentBank = 0; currentVelocity = 0
                    creatureWorldPos = creatureCF.Position
                    cNotif("Mythic Creature tamed! WASD = Move, Shift = Sprint, Space = Fly 🚀", 6)
                elseif not isAnyoneSitting() then
                    rideState = "resting"
                end

            elseif rideState == "manual_ground" then
                local moveDir = Vector3.new(0,0,0)
                if uis:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Vector3.new(0,0,-1) end
                if uis:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir + Vector3.new(0,0,1) end
                if uis:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir + Vector3.new(-1,0,0) end
                if uis:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Vector3.new(1,0,0) end

                local isRunning = uis:IsKeyDown(Enum.KeyCode.LeftShift) or isUIBoost
                local targetSpeed = 0

                if moveDir.Magnitude > 0.1 then
                    targetSpeed = isRunning and 140 or 50
                    local cam = ws.CurrentCamera
                    local camYaw = math.atan2(-cam.CFrame.LookVector.X, -cam.CFrame.LookVector.Z)
                    local localYaw = math.atan2(-moveDir.X, -moveDir.Z)
                    local targetYaw = camYaw + localYaw
                    local angleDiff = targetYaw - currentYaw
                    while angleDiff >  math.pi do angleDiff = angleDiff - 2*math.pi end
                    while angleDiff < -math.pi do angleDiff = angleDiff + 2*math.pi end
                    currentYaw = currentYaw + angleDiff * 10 * dt
                end

                currentVelocity = currentVelocity + (targetSpeed - currentVelocity) * 8 * dt
                local forwardDir = (CFrame.new(Vector3.new(), Vector3.new(0,0,-1)) * CFrame.Angles(0, currentYaw, 0)).LookVector
                creatureWorldPos = creatureWorldPos + forwardDir * currentVelocity * dt

                local rayParams = RaycastParams.new()
                local _ignoreList = {lp.Character}
                for _, pd in ipairs(creatureParts) do if pd.propModel then table.insert(_ignoreList, pd.propModel) end end
                rayParams.FilterDescendantsInstances = _ignoreList
                rayParams.FilterType = Enum.RaycastFilterType.Exclude

                local result = ws:Raycast(creatureWorldPos + Vector3.new(0, 100, 0), Vector3.new(0, -200, 0), rayParams)
                local groundY = result and result.Position.Y or (creatureWorldPos.Y - CREATURE_HEIGHT)
                local targetY = groundY + CREATURE_HEIGHT
                creatureWorldPos = Vector3.new(creatureWorldPos.X,
                    creatureWorldPos.Y + math.clamp(targetY - creatureWorldPos.Y, -60*dt, 60*dt),
                    creatureWorldPos.Z)

                local pitchTarget = 0
                if result and currentVelocity > 5 then
                    local fResult = ws:Raycast(creatureWorldPos + Vector3.new(0,100,0) + forwardDir*8, Vector3.new(0,-200,0), rayParams)
                    if fResult then pitchTarget = math.atan2(fResult.Position.Y - groundY, 8) end
                end
                currentPitch = currentPitch + (pitchTarget - currentPitch) * 6 * dt
                currentBank  = currentBank  + (0 - currentBank) * 6 * dt

                creatureCF = CFrame.new(creatureWorldPos) * CFrame.Angles(0, currentYaw, 0) * CFrame.Angles(currentPitch, 0, currentBank) * CFrame.Angles(0, math.pi, 0)
                animTime = animTime + dt * (1 + currentVelocity / 30)

                if uis:IsKeyDown(Enum.KeyCode.Space) or isUIUp or creatureForceTakeoff then
                    creatureForceTakeoff = false
                    rideState = "manual_flight"
                    cNotif("In Flight! WASD = Fly | Space = Ascend | Ctrl = Descend | Shift = Turbo", 5)
                end

                if not isDriverSitting() and not isAnyoneSitting() then
                    removeCreatureGUI()
                    pcall(function() lp.Character:FindFirstChildOfClass("Humanoid"):SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end)
                    -- Save current position so creature stays in place after dismount
                    spawnOrigin = CFrame.new(creatureWorldPos) * CFrame.Angles(0, currentYaw, 0) * CFrame.Angles(0, math.pi, 0)
                    rideState = "resting"
                end

            elseif rideState == "manual_flight" then
                local moveDir = Vector3.new(0,0,0)
                if uis:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Vector3.new(0,0,-1) end
                if uis:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir + Vector3.new(0,0,1) end
                if uis:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir + Vector3.new(-1,0,0) end
                if uis:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Vector3.new(1,0,0) end

                local isRunning = uis:IsKeyDown(Enum.KeyCode.LeftShift) or isUIBoost
                local targetSpeed = isRunning and 300 or 120

                local bankTarget = 0
                if moveDir.Magnitude > 0.1 then
                    local cam = ws.CurrentCamera
                    local camYaw = math.atan2(-cam.CFrame.LookVector.X, -cam.CFrame.LookVector.Z)
                    local localYaw = math.atan2(-moveDir.X, -moveDir.Z)
                    local targetYaw = camYaw + localYaw
                    local angleDiff = targetYaw - currentYaw
                    while angleDiff >  math.pi do angleDiff = angleDiff - 2*math.pi end
                    while angleDiff < -math.pi do angleDiff = angleDiff + 2*math.pi end
                    currentYaw = currentYaw + angleDiff * 8 * dt
                    currentVelocity = currentVelocity + (targetSpeed - currentVelocity) * 5 * dt
                    bankTarget = -angleDiff * 0.35
                else
                    currentVelocity = currentVelocity + (0 - currentVelocity) * 2 * dt
                end

                local vSpeed = 0
                if uis:IsKeyDown(Enum.KeyCode.Space) or isUIUp then vSpeed = 100 end
                if uis:IsKeyDown(Enum.KeyCode.LeftControl) or isUIDown then vSpeed = -100 end

                local forwardDir = (CFrame.new(Vector3.new(), Vector3.new(0,0,-1)) * CFrame.Angles(0, currentYaw, 0)).LookVector
                creatureWorldPos = creatureWorldPos + forwardDir * currentVelocity * dt
                creatureWorldPos = creatureWorldPos + Vector3.new(0, vSpeed * dt, 0)

                local pitchTarget = (vSpeed / 100) * math.rad(20)
                currentPitch = currentPitch + (pitchTarget - currentPitch) * 5 * dt
                currentBank  = currentBank  + (bankTarget  - currentBank)  * 5 * dt

                local minX, maxX = -1425, 1454
                local minZ, maxZ = -1476, 1403
                if creatureWorldPos.X < minX or creatureWorldPos.X > maxX or creatureWorldPos.Z < minZ or creatureWorldPos.Z > maxZ then
                    local toCenter = Vector3.new(0,0,0) - creatureWorldPos
                    creatureWorldPos = creatureWorldPos + toCenter.Unit * currentVelocity * dt
                end

                creatureCF = CFrame.new(creatureWorldPos) * CFrame.Angles(0, currentYaw, 0) * CFrame.Angles(currentPitch, 0, currentBank) * CFrame.Angles(0, math.pi, 0)
                animTime = animTime + dt * (1 + currentVelocity / 50)

                local rayParams2 = RaycastParams.new()
                local _il2 = {lp.Character}
                for _, pd in ipairs(creatureParts) do if pd.propModel then table.insert(_il2, pd.propModel) end end
                rayParams2.FilterDescendantsInstances = _il2
                rayParams2.FilterType = Enum.RaycastFilterType.Exclude
                local result2 = ws:Raycast(creatureWorldPos, Vector3.new(0, -CREATURE_HEIGHT - 10, 0), rayParams2)
                if result2 and vSpeed < 0 then
                    rideState = "manual_ground"
                    spawnOrigin = CFrame.new(creatureWorldPos) * CFrame.Angles(0, currentYaw, 0) * CFrame.Angles(0, math.pi, 0)
                    cNotif("Landing successful!", 3)
                end

                if not isDriverSitting() and not isAnyoneSitting() then
                    removeCreatureGUI()
                    pcall(function() lp.Character:FindFirstChildOfClass("Humanoid"):SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end)
                    -- Land creature on ground at current position when dismounting in flight
                    local rpLand = RaycastParams.new()
                    local _ilLand = {lp.Character}
                    for _, pd in ipairs(creatureParts) do if pd.propModel then table.insert(_ilLand, pd.propModel) end end
                    rpLand.FilterDescendantsInstances = _ilLand
                    rpLand.FilterType = Enum.RaycastFilterType.Exclude
                    local rLand = ws:Raycast(creatureWorldPos + Vector3.new(0,200,0), Vector3.new(0,-400,0), rpLand)
                    if rLand then
                        creatureWorldPos = Vector3.new(creatureWorldPos.X, rLand.Position.Y + CREATURE_HEIGHT, creatureWorldPos.Z)
                    end
                    spawnOrigin = CFrame.new(creatureWorldPos) * CFrame.Angles(0, currentYaw, 0) * CFrame.Angles(0, math.pi, 0)
                    rideState = "resting"
                end
            end

            animTime = animTime + dt

            for _, pData in ipairs(creatureParts) do
                local bp = pData.blueprint
                if bp and pData.scf then
                    local animDelta = getPartAnimDelta(bp.key, animTime, currentVelocity, rideState)
                    local finalRot  = bp.rot or CFrame.Angles(0,0,0)
                    local partCF    = creatureCF * CFrame.new(bp.off) * finalRot * animDelta
                    cStream:setCF(pData.scf, partCF)
                end
            end
        end)
    end

    -- UI : Attraction Mythic Creature
    BuildTab:AddSection({"Attraction: Mythic Creature"})

    BuildTab:AddToggle({
        Name = "Summon Mythic Creature",
        Description = "Summons a controllable mythic flying creature mount",
        Default = false,
        Callback = function(val)
            if not _G.BTR_UI_READY then return end
            if not val and not creatureActive then return end
            creatureActive = val
            if val then
                task.spawn(function()
                    spawnCreature()
                    if creatureActive then startCreatureLoop() end
                end)
            else
                if creatureLoop then creatureLoop:Disconnect() creatureLoop = nil end
                cStream:stop()
                if creatureSitConn then creatureSitConn:Disconnect() creatureSitConn = nil end
                removeCreatureGUI()
                pcall(function() lp.Character:FindFirstChildOfClass("Humanoid"):SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end)
                pcall(function()
                    game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("1Clea1rTool1s"):FireServer("ClearAllProps")
                end)
                creatureParts = {}
                cNotif("The Mythic Creature returns to the void...", 3)
            end
        end
    })

