-- Onglet 12 : Protection

-- ========================================================
-- [PROTECTION SYSTEM] Anti-Sit / Anti-Fling / Anti-Tools
-- Compatible with our own Vehicle Fling (flag check)
-- ========================================================
do
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer
    local Workspace = game:GetService("Workspace")
    local StarterGui = game:GetService("StarterGui")

    -- Flag set by the Vehicle Fling system (Ambulance/Bus) to avoid self-kill
    _G.VehicleFlingActive = false
    _G.VehicleFlingCar = nil

    local function isOurFlingVehicle(item)
        -- Name-based: vehicles spawned via PickingCar are named "<PlayerName>Car"
        if _G.VehicleFlingActive and item.Name == LocalPlayer.Name .. "Car" then
            return true
        end
        -- Seat-based: we are sitting inside it right now
        if LocalPlayer.Character then
            for _, seat in ipairs(item:GetDescendants()) do
                if (seat:IsA("VehicleSeat") or seat:IsA("Seat")) and seat.Occupant and seat.Occupant.Parent == LocalPlayer.Character then
                    return true
                end
            end
        end
        return false
    end

    -- ============ ANTI-SIT ============
    do
        local antiSitConnections = {}
        local isAntiSitActive = false

        local function resetSitting()
            local player = game.Players.LocalPlayer
            for _, connection in ipairs(antiSitConnections) do
                if connection and connection.Connected then
                    connection:Disconnect()
                end
            end
            antiSitConnections = {}
            local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            end
            isAntiSitActive = false
        end

        local function activateAntiSit()
            local player = game.Players.LocalPlayer
            resetSitting()
            isAntiSitActive = true

            local function preventSitting(humanoid)
                if humanoid then
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                    local sitConnection = humanoid.StateChanged:Connect(function(_, newState)
                        -- Respect our own Vehicle Fling: allow sitting when we are flinging
                        if newState == Enum.HumanoidStateType.Seated and _G.AntiSitValue and not _G.VehicleFlingActive then
                            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                        end
                    end)
                    table.insert(antiSitConnections, sitConnection)
                end
            end

            local function onCharacterAdded(character)
                local humanoid = character:WaitForChild("Humanoid")
                preventSitting(humanoid)
            end

            local characterAddedConnection = player.CharacterAdded:Connect(onCharacterAdded)
            table.insert(antiSitConnections, characterAddedConnection)
            if player.Character then
                onCharacterAdded(player.Character)
            end

            local heartbeatConnection = RunService.Heartbeat:Connect(function()
                local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    if _G.AntiSitValue and not _G.VehicleFlingActive then
                        -- Anti-sit active AND not flinging: block sitting
                        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                    elseif _G.VehicleFlingActive then
                        -- We are flinging: RE-ENABLE sitting so we can sit in the ambulance
                        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
                    end
                end
            end)
            table.insert(antiSitConnections, heartbeatConnection)
        end

        local function setAntiSitCallback(Value)
            _G.AntiSitValue = Value
            if Value then
                activateAntiSit()
            else
                resetSitting()
            end
        end
        _G.BTR_PROT_CALLBACKS.AntiSit = setAntiSitCallback

        _G.AntiSitToggle = ProtectionTab:AddToggle({
            Name = "Anti-Sit",
            Description = "No sitting (auto-paused during your own Vehicle Fling)",
            Default = (_G.BTR_AUTORUN and _G.BTR_AUTORUN.AntiSit ~= false),
            Callback = function(Value)
                _G.setBTRProtection("AntiSit", Value, "ProtectionTab")
            end
        })
        _G.BTR_PROT_TOGGLES.AntiSit = _G.AntiSitToggle

        _G.AntiSitValue = (_G.BTR_AUTORUN and _G.BTR_AUTORUN.AntiSit ~= false)
    end

    -- [LOCKED Keito] Force OFF/ON de l'anti-sit SANS passer par Toggle:Set()
    -- (Toggle:Set() ne declenche PAS le Callback RedzLib => les connections
    --  StateChanged + Heartbeat resteraient actives et bloqueraient Seated)
    _G.AntiSitForceOff = function()
        _G.AntiSitValue = false
        resetSitting()  -- detruit les connections + re-active Seated
        -- [FIX Keito v7] Synchronise le toggle UI pour qu'il reflete l'etat reel
        if _G.AntiSitToggle then
            pcall(function() _G.AntiSitToggle:Set(false) end)
        end
    end
    _G.AntiSitForceOn = function()
        _G.AntiSitValue = true
        activateAntiSit()
        -- [FIX Keito v7] Synchronise le toggle UI pour qu'il reflete l'etat reel
        if _G.AntiSitToggle then
            pcall(function() _G.AntiSitToggle:Set(true) end)
        end
    end

    -- ============ ANTI-FLING (separate toggles, optimized - no lag) ============
    -- Shared destroyer: keeps state per folder and runs on a 0.1s tick
    local antiFlingStates = {
        Vehicles = false,
        Canoes = false,
        Jets = false,
        Helis = false,
        Balls = false,
        Doors = false
    }

    local function destroyForeignIn(folder)
        if not folder then return end
        for _, item in ipairs(folder:GetChildren()) do
            if isOurFlingVehicle(item) then continue end
            -- Seat check: is someone we know sitting in it? skip
            local occupiedByUs = false
            if LocalPlayer.Character then
                for _, seat in ipairs(item:GetDescendants()) do
                    if (seat:IsA("VehicleSeat") or seat:IsA("Seat")) and seat.Occupant and seat.Occupant.Parent == LocalPlayer.Character then
                        occupiedByUs = true
                        break
                    end
                end
            end
            if not occupiedByUs then
                pcall(function() item:Destroy() end)
            end
        end
    end

    -- Doors handled in ONE pass (not per-frame) to avoid lag
    local function hideDoors()
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Name:lower():find("door") then
                v.Transparency = 1
                v.CanCollide = false
            end
        end
    end

    local function antiFlingTick()
        local anyActive = antiFlingStates.Vehicles or antiFlingStates.Canoes or antiFlingStates.Jets
            or antiFlingStates.Helis or antiFlingStates.Balls
        if not anyActive then return end

        if antiFlingStates.Vehicles then
            local vFolder = Workspace:FindFirstChild("Vehicles")
            if vFolder then destroyForeignIn(vFolder) end
        end
        if antiFlingStates.Canoes then
            local wc = Workspace:FindFirstChild("WorkspaceCom")
            local canoes = wc and wc:FindFirstChild("001_CanoeStorage")
            if canoes then destroyForeignIn(canoes) end
        end
        if antiFlingStates.Jets then
            local wc = Workspace:FindFirstChild("WorkspaceCom")
            local airport = wc and wc:FindFirstChild("001_Airport")
            local hangar = airport and airport:FindFirstChild("AirportHanger")
            local jetStorage = hangar and hangar:FindFirstChild("001_JetStorage")
            local jets = jetStorage and jetStorage:FindFirstChild("JetAirport")
            if jets then destroyForeignIn(jets) end
        end
        if antiFlingStates.Helis then
            local wc = Workspace:FindFirstChild("WorkspaceCom")
            local helis = wc and wc:FindFirstChild("001_HeliStorage")
            local heli = helis and helis:FindFirstChild("PoliceStationHeli")
            if heli then destroyForeignIn(heli) end
        end
        if antiFlingStates.Balls then
            local wc = Workspace:FindFirstChild("WorkspaceCom")
            local balls = wc and wc:FindFirstChild("001_SoccerBalls")
            if balls then destroyForeignIn(balls) end
        end
    end

    task.spawn(function()
        while true do
            antiFlingTick()
            task.wait(0.1)
        end
    end)

    -- Separate toggles & Callbacks registration
    _G.BTR_PROT_TOGGLES = _G.BTR_PROT_TOGGLES or {}
    _G.BTR_PROT_CALLBACKS = _G.BTR_PROT_CALLBACKS or {}

    local function setVehicles(state) antiFlingStates.Vehicles = state end
    local function setCanoes(state) antiFlingStates.Canoes = state end
    local function setJets(state) antiFlingStates.Jets = state end
    local function setHelis(state) antiFlingStates.Helis = state end
    local function setBalls(state) antiFlingStates.Balls = state end
    local function setDoors(state)
        antiFlingStates.Doors = state
        if state then hideDoors() end
    end

    _G.BTR_PROT_CALLBACKS.Vehicles = setVehicles
    _G.BTR_PROT_CALLBACKS.Canoes = setCanoes
    _G.BTR_PROT_CALLBACKS.Jets = setJets
    _G.BTR_PROT_CALLBACKS.Helis = setHelis
    _G.BTR_PROT_CALLBACKS.Balls = setBalls
    _G.BTR_PROT_CALLBACKS.Doors = setDoors

    _G.BTR_PROT_TOGGLES.Vehicles = ProtectionTab:AddToggle({
        Name = "Anti Fling Vehicles",
        Description = "Destroys foreign vehicles (skips your own fling)",
        Default = (_G.BTR_AUTORUN and _G.BTR_AUTORUN.Vehicles == true) or false,
        Callback = function(state) _G.setBTRProtection("Vehicles", state, "ProtectionTab") end
    })
    _G.BTR_PROT_TOGGLES.Canoes = ProtectionTab:AddToggle({
        Name = "Anti Canoe Fling",
        Description = "Destroys foreign canoes",
        Default = (_G.BTR_AUTORUN and _G.BTR_AUTORUN.Canoes == true) or false,
        Callback = function(state) _G.setBTRProtection("Canoes", state, "ProtectionTab") end
    })
    _G.BTR_PROT_TOGGLES.Jets = ProtectionTab:AddToggle({
        Name = "Anti Fling Jets",
        Description = "Destroys foreign jets",
        Default = (_G.BTR_AUTORUN and _G.BTR_AUTORUN.Jets == true) or false,
        Callback = function(state) _G.setBTRProtection("Jets", state, "ProtectionTab") end
    })
    _G.BTR_PROT_TOGGLES.Helis = ProtectionTab:AddToggle({
        Name = "Anti Fling Helicopters",
        Description = "Destroys foreign helicopters",
        Default = (_G.BTR_AUTORUN and _G.BTR_AUTORUN.Helis == true) or false,
        Callback = function(state) _G.setBTRProtection("Helis", state, "ProtectionTab") end
    })
    _G.BTR_PROT_TOGGLES.Balls = ProtectionTab:AddToggle({
        Name = "Anti Fling Ball",
        Description = "Destroys soccer balls",
        Default = (_G.BTR_AUTORUN and _G.BTR_AUTORUN.Balls == true) or false,
        Callback = function(state) _G.setBTRProtection("Balls", state, "ProtectionTab") end
    })
    _G.BTR_PROT_TOGGLES.Doors = ProtectionTab:AddToggle({
        Name = "Anti Fling Doors",
