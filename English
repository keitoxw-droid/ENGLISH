function _G.saveBTRConfig()
    if writefile then
        pcall(function()
            local data = {
                antiCopyReaction = _G.BTR_ANTI_COPY_REACTION,
                selectedOutfitSlot = _G.BTR_OUTFIT_SLOT,
                autoRun = _G.BTR_AUTORUN
            }
            writefile(BTR_CONFIG_FILE, game:GetService("HttpService"):JSONEncode(data))
        end)
    end
end

function _G.loadBTRConfig()
    if isfile and readfile and isfile(BTR_CONFIG_FILE) then
        pcall(function()
            local raw = readfile(BTR_CONFIG_FILE)
            local data = game:GetService("HttpService"):JSONDecode(raw)
            if data then
                if data.antiCopyReaction then _G.BTR_ANTI_COPY_REACTION = data.antiCopyReaction end
                if data.selectedOutfitSlot then _G.BTR_OUTFIT_SLOT = tonumber(data.selectedOutfitSlot) or 1 end
                if data.autoRun and type(data.autoRun) == "table" then
                    for k, v in pairs(data.autoRun) do
                        _G.BTR_AUTORUN[k] = (v == true)
                    end
                end
            end
        end)
    end
end

-- Chargement immédiat de la configuration enregistrée
