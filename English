        Default = (_G.BTR_AUTORUN and _G.BTR_AUTORUN.Doors == true) or false,
        Callback = function(state) _G.setBTRProtection("Doors", state, "ProtectionTab") end
    })

    -- ============ ANTI DUMP TOOL ============
    local _antiDumpRunning = false
    local function setAntiDump(state)
        _antiDumpRunning = state
        if state then
            task.spawn(function()
                while _antiDumpRunning do
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer then
                            local char = plr.Character
                            local backpack = plr:FindFirstChildOfClass("Backpack")
