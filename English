                table.insert(robotChatConn, TCS.MessageReceived:Connect(function(msg)
                    if msg and msg.TextSource then
                        local p = game:GetService("Players"):GetPlayerByUserId(msg.TextSource.UserId)
                        if p then onChat(p, msg.Text) end
                    end
