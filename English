-- Helper de synchronisation bidirectionnelle instantanée
local _btrSyncing = false
function _G.setBTRProtection(key, state, fromWhere)
    _G.BTR_AUTORUN[key] = (state == true)
    _G.saveBTRConfig()

    -- 1) Exécuter la vraie logique de protection
    local cb = _G.BTR_PROT_CALLBACKS and _G.BTR_PROT_CALLBACKS[key]
    if cb then pcall(function() cb(state) end) end

    -- 2) Synchroniser les toggles UI
    if not _btrSyncing then
        _btrSyncing = true
        if fromWhere ~= "ProtectionTab" then
            local pTg = _G.BTR_PROT_TOGGLES and _G.BTR_PROT_TOGGLES[key]
            if pTg and pTg.Set then pcall(function() pTg:Set(state) end) end
        end
        if fromWhere ~= "SettingsTab" then
            local sTg = _G.BTR_SETTINGS_TOGGLES and _G.BTR_SETTINGS_TOGGLES[key]
            if sTg and sTg.Set then pcall(function() sTg:Set(state) end) end
        end
        _btrSyncing = false
    end
end

function _G.syncAutoProtections()
    if not _G.BTR_AUTORUN then return end
    for key, enabled in pairs(_G.BTR_AUTORUN) do
        local cb = _G.BTR_PROT_CALLBACKS[key]
        if cb then
            pcall(function() cb(enabled == true) end)
        end
        local tg = _G.BTR_PROT_TOGGLES[key]
        if tg and tg.Set then
            pcall(function() tg:Set(enabled == true) end)
        end
    end
end

