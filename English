-- Trace en direct dans la console (F9) toutes les modifications physiques sur le personnage
local function BTR_LOG(tag, msg)
    local formatted = string.format("[BTR-DEBUG][%s] %s", tostring(tag), tostring(msg))
    print(formatted)
    if rconsoleprint then pcall(function() rconsoleprint(formatted .. "\n") end) end
end

task.spawn(function()
    local function hookCharacterDiagnostics(char)
        if not char then return end
        local hum = char:WaitForChild("Humanoid", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)

        if hum then
            BTR_LOG("HUMANOID", string.format("Hooked! WalkSpeed=%s, JumpHeight=%s, JumpPower=%s, UseJumpPower=%s, HipHeight=%s", 
                tostring(hum.WalkSpeed), tostring(hum.JumpHeight), tostring(hum.JumpPower), tostring(hum.UseJumpPower), tostring(hum.HipHeight)))

            hum.StateChanged:Connect(function(oldState, newState)
                if newState == Enum.HumanoidStateType.Jumping or newState == Enum.HumanoidStateType.Freefall or newState == Enum.HumanoidStateType.Landed then
                    BTR_LOG("STATE", string.format("StateChanged: %s -> %s (PlatformStand=%s, Sit=%s)", tostring(oldState.Name), tostring(newState.Name), tostring(hum.PlatformStand), tostring(hum.Sit)))
                end
            end)

            hum:GetPropertyChangedSignal("UseJumpPower"):Connect(function()
                BTR_LOG("PHYSICS", "UseJumpPower changed to: " .. tostring(hum.UseJumpPower))
            end)
            hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
                BTR_LOG("PHYSICS", "JumpPower changed to: " .. tostring(hum.JumpPower))
            end)
            hum:GetPropertyChangedSignal("JumpHeight"):Connect(function()
                BTR_LOG("PHYSICS", "JumpHeight changed to: " .. tostring(hum.JumpHeight))
            end)
            hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                BTR_LOG("PHYSICS", "WalkSpeed changed to: " .. tostring(hum.WalkSpeed))
            end)
            hum:GetPropertyChangedSignal("HipHeight"):Connect(function()
                BTR_LOG("PHYSICS", "HipHeight changed to: " .. tostring(hum.HipHeight))
            end)
            hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
                BTR_LOG("PHYSICS", "PlatformStand changed to: " .. tostring(hum.PlatformStand))
            end)
        end

        if hrp then
            hrp.ChildAdded:Connect(function(child)
                if child:IsA("BodyMover") or child:IsA("Constraint") or child:IsA("BodyVelocity") or child:IsA("BodyPosition") or child:IsA("BodyGyro") then
                    BTR_LOG("BODYMOVER", "Added on HRP: " .. child.ClassName .. " (" .. child.Name .. ")")
                end
            end)
        end
    end

    if LocalPlayer.Character then
        hookCharacterDiagnostics(LocalPlayer.Character)
    end
    LocalPlayer.CharacterAdded:Connect(hookCharacterDiagnostics)
end)

