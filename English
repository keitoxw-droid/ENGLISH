            local n2, oct = n:match("([A-G]#?)(%d+)")
            return tonumber(oct)*12 + pitch[n2]
        end
        return getVal(a) < getVal(b)
    end)
    for i, n in ipairs(NoteMapping) do KeysToNotes[n] = notes[i] end
end

