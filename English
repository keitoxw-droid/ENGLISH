                    if sender then
                        processIncomingChat(sender, textContent)
                    end
                end)
                table.insert(_G.BTR_FakeAdminConns, conn)
            end

            -- Écoute de chaque TextChannel
            if TCS and TCS:FindFirstChild("TextChannels") then
                for _, ch in ipairs(TCS.TextChannels:GetChildren()) do
                    if ch:IsA("TextChannel") then
                        local conn = ch.MessageReceived:Connect(function(msg)
                            if not msg then return end
                            local textContent = msg.Text or msg.RawText
                            if not textContent then return end
                            local sender = nil
                            if msg.TextSource then
