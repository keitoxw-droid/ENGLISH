    local function canDo(actionKey, cooldownSec)
        local now = tick()
        if robotCooldowns[actionKey] and (now - robotCooldowns[actionKey]) < cooldownSec then
            return false
        end
        robotCooldowns[actionKey] = now
        return true
    end

    -- ============================================================
    -- CALCUL POSITION MONDE D'UNE PARTIE
    -- ============================================================
    local function getPartCFrame(layout, t, state, risingProg, partIndex)
        local robotCF = CFrame.new(robotAnchor) * CFrame.Angles(0, robotAngle, 0)

        local baseOff = layout.off
        local baseRot = layout.rot or CFrame.new()
        local animOff = layout.anim(t, state)

        if state == "dormant" then
            if layout.key == "core" then
                animOff = CFrame.new(0, -22, 0)
            elseif layout.key == "armL" or layout.key == "armR" then
                animOff = CFrame.new(0, -10, -8) * CFrame.Angles(-math.pi/1.5, 0, 0)
            else
                animOff = CFrame.new(0, -40, 0)
            end
        elseif state == "kneel" then
            animOff = CFrame.new(0, -20, 0) * layout.anim(t, "idle")
        elseif state == "shield" then
            local totalParts = #ROBOT_LAYOUT
            local spinAngle = robotAnimT * 10 + partIndex * (math.pi * 2 / totalParts)
            local orbitR = 18
            local spinY = math.sin(robotAnimT * 5 + partIndex * 1.5) * 12

            baseOff = Vector3.new(
                math.cos(spinAngle) * orbitR,
                spinY,
                math.sin(spinAngle) * orbitR
            )
            baseRot = CFrame.new()
            animOff = CFrame.Angles(robotAnimT * 15, robotAnimT * 12, partIndex)
        end

        -- Rising progressif : animation vortex
        local smoothProg = math.clamp(risingProg, 0, 1)
        smoothProg = smoothProg * smoothProg * (3 - 2 * smoothProg)

        local spinFactor = (1 - smoothProg)
        local spiralAngle = spinFactor * math.pi * 5 * (partIndex % 2 == 0 and 1 or -1)
        local spiralRadius = 25 * spinFactor
        local undergroundY = -40 * spinFactor

        local vortexOff = Vector3.new(
            math.cos(spiralAngle) * spiralRadius,
            undergroundY,
            math.sin(spiralAngle) * spiralRadius
        )

        local localPos = baseOff + vortexOff
        local worldPos = (robotCF * CFrame.new(localPos)).Position

        local vortexRot = CFrame.Angles(spiralAngle * 0.4, spiralAngle * 0.6, spiralAngle * 0.2)
        local worldCF = CFrame.new(worldPos) * CFrame.Angles(0, robotAngle, 0) * baseRot * animOff * vortexRot

        if risingProg < 1 and risingProg > 0.05 then
            local shake = math.sin(t * 30) * 0.3 * spinFactor
            worldCF = worldCF * CFrame.new(shake, shake, shake)
        end
        return worldCF
    end

    -- ============================================================
    -- SPAWN DU ROBOT (placement rapide 0.85s comme le Blind)
    -- ============================================================
    local function spawnRobot()
        local lp = game:GetService("Players").LocalPlayer
        local char = lp.Character or lp.CharacterAdded:Wait()
        local humanoid = char:WaitForChild("Humanoid")
        local myRoot = char:WaitForChild("HumanoidRootPart")

        rNotif("MECHA ROBOT", "Summoning Mecha Robot...", 4)

        local RE = game:GetService("ReplicatedStorage"):WaitForChild("RE")
        local clearTools = RE:WaitForChild("1Clea1rTool1s")
        local myPropName = "Prop" .. lp.Name

        pcall(function() clearTools:FireServer("ClearAllProps") end)
        task.wait(0.5)

        local propsTool = getOrFetchPropMaker()
        if not propsTool then
            rNotif("Mecha Robot", "Error: PropMaker not found!", 4)
            return
        end

        pcall(function() clearTools:FireServer("OpenPropMenu") end)
        task.wait(0.2)

        local toolPropMake = propsTool:FindFirstChild("Tool_PropMake") or propsTool:WaitForChild("Tool_PropMake", 3)
        if not toolPropMake then return end -- silent exit (PropMaker rule)

        ROBOT_GROUND_Y = myRoot.Position.Y
        robotAnchor = myRoot.Position
        robotAnchor = Vector3.new(robotAnchor.X, ROBOT_GROUND_Y, robotAnchor.Z)
        local spawnPos = robotAnchor - Vector3.new(0, 40, 0)

        robotScf = {}
        local knownScf = {}
        for _, folder in pairs(workspace:WaitForChild("WorkspaceCom"):GetChildren()) do
            for _, prop in pairs(folder:GetChildren()) do
                if prop.Name == myPropName then
                    local scf = prop:FindFirstChild("SetCurrentCFrame")
                    if scf then knownScf[scf] = true end
                end
            end
        end

        local defaultColor = Color3.fromRGB(0, 160, 255)
        local hitInst = workspace.Terrain
        local Telemetry = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TelemetryClientInteraction")

        -- Placement RAPIDE : 0.85s/prop comme le Blind
        local PLACE_INTERVAL = 0.85
        for partIndex, layout in ipairs(ROBOT_LAYOUT) do
            if not robotActive then break end

            pcall(function() Telemetry:FireServer("filterClick", {name=layout.cat,  itemType="Props"}) end)
            task.wait(0.05)
            pcall(function() Telemetry:FireServer("filterClick", {name=layout.prop, itemType="Props"}) end)
            task.wait(0.05)
            pcall(function() clearTools:FireServer("RequestingPropName", layout.prop, layout.cat) end)
            task.wait(0.2)

            pcall(function() toolPropMake:FireServer(hitInst, robotAnchor) end)
            task.wait(PLACE_INTERVAL - 0.3) -- 0.85s/prop total = même rythme que le Blind

            local foundScf = nil
            local foundCpc = nil
            for _, folder in pairs(workspace:WaitForChild("WorkspaceCom"):GetChildren()) do
                for _, prop in pairs(folder:GetChildren()) do
                    if prop.Name == myPropName then
                        local scf = prop:FindFirstChild("SetCurrentCFrame")
                        local cpc = prop:FindFirstChild("ChangePropColor")
                        if scf and not knownScf[scf] then
                            foundScf = scf
                            foundCpc = cpc
                            knownScf[scf] = true
                        end
                    end
                end
            end

            robotScf[layout.key] = {scf = foundScf, cpc = foundCpc}
            if foundScf then
                pcall(function() foundScf:InvokeServer(CFrame.new(spawnPos)) end)
            end
            if foundCpc then
                pcall(function() foundCpc:InvokeServer(defaultColor) end)
            end
        end

        task.wait(1)
        pcall(function() game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("1Too1l"):InvokeServer("PickingTools", "PropMaker") end)
        pcall(function() clearTools:FireServer("ClosePropMenu") end)
        cleanupPropMakerTool()

        local count = 0
        for _ in pairs(robotScf) do count = count + 1 end
        rNotif("MECHA ROBOT", "Robot online! " .. count .. "/15 parts ready. Say 'wake up' to activate!", 6)
    end

    -- ============================================================
    -- IA : ÉVITEMENT D'OBSTACLES
    -- ============================================================
    local function getRobotSteer(pos, currentAngle, checkDist)
        local fwd = Vector3.new(math.sin(currentAngle), 0, math.cos(currentAngle))
        local left = Vector3.new(math.sin(currentAngle - 0.7), 0, math.cos(currentAngle - 0.7))
        local right = Vector3.new(math.sin(currentAngle + 0.7), 0, math.cos(currentAngle + 0.7))

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {game:GetService("Players").LocalPlayer.Character, workspace:FindFirstChild("WorkspaceCom")}

        local yOffset = Vector3.new(0, 10, 0)
        local hitFwd = workspace:Raycast(pos + yOffset, fwd * checkDist, rayParams)
        local hitL = workspace:Raycast(pos + yOffset, left * checkDist, rayParams)
        local hitR = workspace:Raycast(pos + yOffset, right * checkDist, rayParams)

        if hitFwd then
            if hitL and not hitR then return 3.0
            elseif hitR and not hitL then return -3.0
            else return (math.random() > 0.5 and 3.5 or -3.5) end
        elseif hitL then return 1.5
        elseif hitR then return -1.5
        end
        return 0
    end

    -- ============================================================
    -- BOUCLE D'ANIMATION (25 FPS THROTTLE)
    -- ============================================================
    local function startRobotLoop()
        if robotLoop then robotLoop:Disconnect() end
        local lastUpdate = 0
        robotAnimT = 0
        robotRisingProgress = 0

        robotLoop = game:GetService("RunService").Heartbeat:Connect(function(dt)
            if not robotActive then return end
            robotAnimT = robotAnimT + dt
            robotStateTimer = robotStateTimer + dt

            -- UPDATE POSITION SELON LE MODE
            if robotState == "attack" then
                local fwd = Vector3.new(math.sin(robotAngle), 0, math.cos(robotAngle))
                robotAnchor = robotAnchor + fwd * 45 * dt

                if robotTarget then
                    local targetChar = workspace:FindFirstChild(robotTarget)
                    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                        local dir = (targetChar.HumanoidRootPart.Position - robotAnchor)
                        dir = Vector3.new(dir.X, 0, dir.Z)
                        if dir.Magnitude > 0 then
                            local targetAngle = math.atan2(dir.X, dir.Z)
                            local angleDiff = (targetAngle - robotAngle + math.pi) % (2 * math.pi) - math.pi
                            robotAngle = robotAngle + math.clamp(angleDiff, -5, 5) * dt
                        end
                    end
                end

            elseif robotState == "walk" then
                if robotMode ~= "follow" and robotMode ~= "free" then
                    local fwd = Vector3.new(math.sin(robotAngle), 0, math.cos(robotAngle))
                    robotAnchor = robotAnchor + fwd * robotSpeed * dt
                end

                if robotMode == "follow" and robotFollowName ~= "" then
                    local tp = game:GetService("Players"):FindFirstChild(robotFollowName)
                    local hrp = tp and tp.Character and tp.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local toTarget = hrp.Position - robotAnchor
                        toTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
                        if toTarget.Magnitude > 6 then
                            local targetAngle = math.atan2(toTarget.X, toTarget.Z)
                            local angleDiff = targetAngle - robotAngle
                            while angleDiff >  math.pi do angleDiff = angleDiff - 2*math.pi end
                            while angleDiff < -math.pi do angleDiff = angleDiff + 2*math.pi end
                            robotAngle = robotAngle + math.clamp(angleDiff, -2.5, 2.5) * dt
                            local dist = toTarget.Magnitude
                            local adaptSpeed = math.clamp(dist * 0.6, robotSpeed, 55)
                            local fwdF = Vector3.new(math.sin(robotAngle), 0, math.cos(robotAngle))
                            robotAnchor = robotAnchor + fwdF * adaptSpeed * dt
                        else
                            robotState = "idle"
                        end
                    end

                elseif robotMode == "free" then
                    if not robotWaypoint then
                        local rAngle = math.random() * 2 * math.pi
                        local rDist  = math.random(40, 120)
                        local nx = math.clamp(robotAnchor.X + math.cos(rAngle) * rDist, -350, 350)
                        local nz = math.clamp(robotAnchor.Z + math.sin(rAngle) * rDist, -350, 350)
                        robotWaypoint = Vector3.new(nx, robotAnchor.Y, nz)
                    end

                    local toWp = robotWaypoint - robotAnchor
                    toWp = Vector3.new(toWp.X, 0, toWp.Z)

                    if toWp.Magnitude < 8 then
                        robotWaypoint = nil
                        robotState    = "idle"
                        if math.random() < 0.3 and canDo("roar_free", 15) then
                            task.delay(0.5, function()
                                if robotActive and robotMode == "free" and robotState == "idle" then
                                    robotState = "roar"
                                    robotStateTimer = 0
                                end
                            end)
                        end
                        task.delay(math.random(2, 7), function()
                            if not robotActive or robotMode ~= "free" then return end
                            if math.random() < 0.4 then
                                local closestHrp, closestD = nil, 250
                                for _, p in pairs(game:GetService("Players"):GetPlayers()) do
                                    local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                                    if hrp then
                                        local d = (hrp.Position - robotAnchor).Magnitude
                                        if d < closestD then closestD = d; closestHrp = hrp end
                                    end
                                end
                                if closestHrp then
                                    robotWaypoint = Vector3.new(closestHrp.Position.X, robotAnchor.Y, closestHrp.Position.Z)
                                end
                            end
                            if robotState == "idle" then robotState = "walk" end
                        end)
                    else
                        local targetAngle = math.atan2(toWp.X, toWp.Z)
                        local angleDiff = targetAngle - robotAngle
                        while angleDiff >  math.pi do angleDiff = angleDiff - 2*math.pi end
                        while angleDiff < -math.pi do angleDiff = angleDiff + 2*math.pi end

                        local turnRate = math.clamp(math.abs(angleDiff) * 3, 1.5, 4.5)
                        robotAngle = robotAngle + math.clamp(angleDiff, -turnRate, turnRate) * dt
                        local alignRatio = 1 - math.min(math.abs(angleDiff) / math.pi, 1) * 0.75
                        robotAnchor = robotAnchor + Vector3.new(math.sin(robotAngle), 0, math.cos(robotAngle)) * (robotSpeed * alignRatio) * dt
                    end
                end
            end

            -- PROGRESSION ÉMERGENCE
            if robotState == "rising" then
                robotRisingProgress = math.min(robotRisingProgress + dt * 0.22, 1)
                if robotRisingProgress >= 1 then
                    robotState = "idle"
                    robotStateTimer = 0
                    rNotif("MECHA ROBOT", "MECHA ROBOT ONLINE!", 5)
                end
            end

            -- AUTO-RETOUR EN IDLE
            if robotState == "attack" and robotStateTimer > 3 then
                robotState = "idle" robotStateTimer = 0
            end
            if robotState == "stomp" and robotStateTimer > 2.5 then
                robotState = "idle" robotStateTimer = 0
            end
            if robotState == "roar" and robotStateTimer > 5 then
                robotState = "idle" robotStateTimer = 0
            end

            -- GESTION GRAVITÉ
            local rayOrigin = Vector3.new(robotAnchor.X, robotAnchor.Y + 200, robotAnchor.Z)
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {
                game:GetService("Players").LocalPlayer.Character,
                workspace:FindFirstChild("WorkspaceCom")
            }
            local rayResult = workspace:Raycast(rayOrigin, Vector3.new(0, -500, 0), rayParams)
            if rayResult then
                local targetY = rayResult.Position.Y
                robotAnchor = Vector3.new(robotAnchor.X, robotAnchor.Y + (targetY - robotAnchor.Y) * math.clamp(dt * 8, 0, 1), robotAnchor.Z)
            end

            -- ENVOI DES CFRAMES (25 FPS)
            if tick() - lastUpdate < 0.04 then return end
            lastUpdate = tick()

            -- GESTION COULEUR
            local _ct = robotAnimT
            local pulse = (math.sin(_ct * 5) + 1) / 2
            local propColor

            if robotColorMode == "Mecha Blue" then
                local bR = 0.1 + pulse * 0.2
                local bG = 0.5 + pulse * 0.3
                local bB = 1.0
                propColor = Color3.new(bR, bG, bB)
            elseif robotColorMode == "Shadow Arise (Violet)" then
                propColor = Color3.new(0.5 + pulse * 0.4, 0.05 + pulse * 0.1, 0.95 + pulse * 0.05)
            elseif robotColorMode == "Magma Red" then
                propColor = Color3.new(pulse * 0.8 + 0.2, 0, 0)
            elseif robotColorMode == "Sacrificial Gold" then
                propColor = Color3.new(0.8 + pulse * 0.2, 0.6 + pulse * 0.3, 0.1)
