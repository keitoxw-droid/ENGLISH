                local startCF = hrp.CFrame

                -- Scan uniquement des vehicules LIBRES (occupied = Network Owner pris)
                scanVehicles()
                local allList = {}
                for _, d in pairs(_G.FunVehicleData) do
                    if d and not d.occupied then
                        table.insert(allList, d)
                    end
                end
                if #allList == 0 then
                    game:GetService("StarterGui"):SetCore("SendNotification", {Title="Remove All Vehicles", Text="No free player vehicles found!", Duration=3})
                    return
                end

                local removed = 0

                -- Meme methode exacte que Carjack (single) mais sur tous les vehicules libres
                for _, d in ipairs(allList) do
                    pcall(function()
                        local car = d.model
                        local seat = d.seat
                        if not car or not seat then return end

                        -- 1) TP sur le siege
                        pcall(function() hrp.CFrame = seat.CFrame * CFrame.new(0, 1.5, 0) end)
                        task.wait(0.2)

                        -- 2) S'asseoir => NetworkOwnership
                        hum.Sit = true
                        local sitTries = 0
                        local sat = false
                        while sitTries < 15 do
                            if hum.SeatPart == seat then sat = true break end
                            pcall(function() seat:Sit(hum) end)
                            hum.Sit = true
                            task.wait(0.1)
                            sitTries = sitTries + 1
                        end
                        if not sat then return end

                        -- 3) Ownership acquis, on stabilise
                        task.wait(0.3)

                        -- 4) FLING VERS LE HAUT (assis => monte, pas de zone kill)
                        local pp = car.PrimaryPart or seat
                        local bv = nil
                        pcall(function()
                            bv = Instance.new("BodyVelocity")
                            bv.Name = "RemoveAllPower"
                            bv.Velocity = Vector3.new(0, 5000, 0) -- HAUT = securise
                            bv.MaxForce = Vector3.new(9e8, 9e8, 9e8)
                            bv.P = 125000
                            bv.Parent = pp
                        end)
                        pcall(function() pp.AssemblyLinearVelocity = Vector3.new(0, 5000, 0) end)
                        task.wait(0.15)

                        -- 5) EJECTION: on se sauve (assis en haut => on a le temps)
                        pcall(function()
                            pp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            pp.RotVelocity = Vector3.new(0, 0, 0)
                        end)
                        task.wait()
                        pcall(function() hum.Sit = false end)
                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                        pcall(function() hum.Jump = true end)
                        pcall(function() hum:UnequipTools() end)
                        local myHrpNow = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                        if myHrpNow then
                            pcall(function()
                                myHrpNow.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                myHrpNow.RotVelocity = Vector3.new(0, 0, 0)
                            end)
                        end

                        -- 6) RE-TP a la position initiale
                        pcall(function()
                            local myChar = lp.Character
                            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                            if myHrp then myHrp.CFrame = startCF end
                        end)

                        -- 7) La voiture redescend au void
                        task.wait(0.2)
                        if bv then
                            pcall(function() bv.Velocity = Vector3.new(1500, -5000, 1500) end)
                        end
                        pcall(function() pp.AssemblyLinearVelocity = Vector3.new(1500, -5000, 1500) end)
                        task.wait(0.2)
                        pcall(function()
                            if car.PrimaryPart then
                                car:PivotTo(CFrame.new(car.PrimaryPart.Position.X, -90000, car.PrimaryPart.Position.Z))
                            else
                                seat.CFrame = CFrame.new(seat.Position.X, -90000, seat.Position.Z)
                            end
                        end)
                        removed = removed + 1
                    end)
                end

                game:GetService("StarterGui"):SetCore("SendNotification", {Title="Remove All Vehicles", Text="Sent " .. removed .. " vehicles to the void! TP back done.", Duration=4})
            end)
        end)
    end
})

