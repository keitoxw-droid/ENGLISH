                    local _, yaw, _ = spawnOrigin:ToEulerAnglesYXZ()
                    currentYaw = yaw
                    currentPitch = 0
                    currentBank = 0
                    currentVelocity = 0
                    unicornWorldPos = unicornCF.Position
                elseif unicornForceTakeoff then
                    unicornForceTakeoff = false
                    rideState = "auto_flight"
                    flightTime = 0
                    flightDistance = 0
                    uNotif("C'est parti pour la promenade automatique ! Profitez de la vue.", 5)
                elseif isAnyoneSitting() then
                    rideState = "waiting"
                    uNotif("Passager installÃƒÂ© ! Montez sur le trÃƒÂ´ne pour conduire ou cliquez sur 'DÃƒÂ©coller'.", 5)
                end

            elseif rideState == "waiting" then
                useFolded = false -- La licorne se lÃƒÂ¨ve sagement en attendant le conducteur
                
                if isDriverSitting() then
                    setupUnicornGUI()
                    rideState = "manual_ground"
                    waitStartTime = tick()
                    uNotif("Licorne domptÃƒÂ©e ! ZQSD pour marcher, MAJ pour courir, ESPACE pour dÃƒÂ©coller.", 6)
                    
                    local _, yaw, _ = spawnOrigin:ToEulerAnglesYXZ()
                    currentYaw = yaw
                    currentPitch = 0
                    currentBank = 0
                    currentVelocity = 0
                    unicornWorldPos = unicornCF.Position
                elseif unicornForceTakeoff then
                    unicornForceTakeoff = false
                    rideState = "auto_flight"
                    flightTime = 0
                    flightDistance = 0
                    uNotif("C'est parti pour la promenade automatique ! Profitez de la vue.", 5)
                elseif not isAnyoneSitting() then
                    rideState = "resting"
                end

            elseif rideState == "manual_ground" then
                useFolded = false
                
                local moveDir = Vector3.new(0,0,0)
                if uis:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Vector3.new(0,0,-1) end
                if uis:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir + Vector3.new(0,0,1) end
                if uis:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir + Vector3.new(-1,0,0) end
                if uis:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Vector3.new(1,0,0) end
                
                local isRunning = uis:IsKeyDown(Enum.KeyCode.LeftShift) or isUIBoost
                local targetSpeed = 0
                
                if moveDir.Magnitude > 0.1 then
                    targetSpeed = isRunning and 140 or 50
                    
                    local cam = ws.CurrentCamera
                    local camLook = cam.CFrame.LookVector
                    local camYaw = (math.atan2 or math.atan)(-camLook.X, -camLook.Z)
                    local localYaw = (math.atan2 or math.atan)(-moveDir.X, -moveDir.Z)
                    local targetYaw = camYaw + localYaw
                    
                    local angleDiff = targetYaw - currentYaw
                    while angleDiff >  math.pi do angleDiff = angleDiff - 2*math.pi end
                    while angleDiff < -math.pi do angleDiff = angleDiff + 2*math.pi end
                    currentYaw = currentYaw + angleDiff * 10 * dt
                end
                
                currentVelocity = currentVelocity + (targetSpeed - currentVelocity) * 8 * dt
                local forwardDir = (CFrame.new(Vector3.new(), Vector3.new(0,0,-1)) * CFrame.Angles(0, currentYaw, 0)).LookVector
                unicornWorldPos = unicornWorldPos + forwardDir * currentVelocity * dt
                
                -- Terrain Raycast Ã¢â‚¬â€ filtre TOUTES les parts pour eviter le self-hit
                local rayOrigin = unicornWorldPos + Vector3.new(0, 100, 0)
                local rayDirection = Vector3.new(0, -200, 0)
                local rayParams = RaycastParams.new()
                local _ignoreList = {lp.Character}
                for _, pd in ipairs(unicornParts) do if pd.propModel then table.insert(_ignoreList, pd.propModel) end end
                rayParams.FilterDescendantsInstances = _ignoreList
                rayParams.FilterType = Enum.RaycastFilterType.Exclude

                local result = ws:Raycast(rayOrigin, rayDirection, rayParams)
                local groundY = result and result.Position.Y or (unicornWorldPos.Y - 10)
                local targetY = groundY + UNICORN_HEIGHT
                -- Clamp correction pour eviter les sauts brusques (max 60 studs/s)
                local maxCorr = 60 * dt
                unicornWorldPos = Vector3.new(unicornWorldPos.X, unicornWorldPos.Y + math.clamp(targetY - unicornWorldPos.Y, -maxCorr, maxCorr), unicornWorldPos.Z)
                
                local pitchTarget = 0
                if result and currentVelocity > 5 then
                    local fOrigin = rayOrigin + forwardDir * 8
                    local fResult = ws:Raycast(fOrigin, rayDirection, rayParams)
                    if fResult then
                        local slopeDiff = fResult.Position.Y - groundY
                        pitchTarget = (math.atan2 or math.atan)(slopeDiff, 8)
                    end
                end
                currentPitch = currentPitch + (pitchTarget - currentPitch) * 6 * dt
                currentBank = currentBank + (0 - currentBank) * 6 * dt
                
                unicornCF = CFrame.new(unicornWorldPos) * CFrame.Angles(0, currentYaw, 0) * CFrame.Angles(currentPitch, 0, currentBank) * CFrame.Angles(0, math.pi, 0)
                animTime = animTime + dt * (1 + currentVelocity / 30)
                
                if uis:IsKeyDown(Enum.KeyCode.Space) or isUIUp or unicornForceTakeoff then
                    unicornForceTakeoff = false
                    rideState = "manual_flight"
                    flightTime = 0
                    uNotif("Envol ! Ã°Å¸Å¡â‚¬ ZQSD pour voler, Espace = Monter, Ctrl = Descendre.", 5)
                end
                
                if not isSomeoneSitting() then
                    removeUnicornGUI()
                    rideState = "idle"
                end

            elseif rideState == "idle" then
                useFolded = false
                unicornCF = CFrame.new(unicornWorldPos) * CFrame.Angles(0, currentYaw, 0) * CFrame.Angles(currentPitch, 0, currentBank) * CFrame.Angles(0, math.pi, 0)
                animTime = animTime + dt
                
                if isDriverSitting() then
                    setupUnicornGUI()
                    rideState = "manual_ground"
                    waitStartTime = tick()
                    uNotif("Licorne domptÃƒÂ©e ! ZQSD pour marcher, MAJ pour courir, ESPACE pour dÃƒÂ©coller.", 6)
                elseif unicornForceTakeoff then
                    unicornForceTakeoff = false
                    rideState = "auto_flight"
                    flightTime = 0
                    flightDistance = 0
                    uNotif("C'est parti pour la promenade automatique ! Profitez de la vue.", 5)
                elseif not isAnyoneSitting() then
                    rideState = "resting"
                end

            elseif rideState == "manual_flight" then
                flightTime = flightTime + dt
                
                local moveDir = Vector3.new(0,0,0)
                if uis:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Vector3.new(0,0,-1) end
                if uis:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir + Vector3.new(0,0,1) end
                if uis:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir + Vector3.new(-1,0,0) end
                if uis:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Vector3.new(1,0,0) end
                
                local isRunning = uis:IsKeyDown(Enum.KeyCode.LeftShift) or isUIBoost
                local targetSpeed = isRunning and 300 or 120
                
                local bankTarget = 0
                if moveDir.Magnitude > 0.1 then
                    local cam = ws.CurrentCamera
                    local camLook = cam.CFrame.LookVector
                    local camYaw = (math.atan2 or math.atan)(-camLook.X, -camLook.Z)
                    local localYaw = (math.atan2 or math.atan)(-moveDir.X, -moveDir.Z)
                    local targetYaw = camYaw + localYaw
                    
                    local angleDiff = targetYaw - currentYaw
                    while angleDiff >  math.pi do angleDiff = angleDiff - 2*math.pi end
                    while angleDiff < -math.pi do angleDiff = angleDiff + 2*math.pi end
                    currentYaw = currentYaw + angleDiff * 8 * dt
                    
                    currentVelocity = currentVelocity + (targetSpeed - currentVelocity) * 5 * dt
                    bankTarget = -angleDiff * 0.35
                else
                    currentVelocity = currentVelocity + (0 - currentVelocity) * 2 * dt
                end
                
                local vSpeed = 0
                if uis:IsKeyDown(Enum.KeyCode.Space) or isUIUp then vSpeed = 100 end
                if uis:IsKeyDown(Enum.KeyCode.LeftControl) or isUIDown then vSpeed = -100 end
                
                local forwardDir = (CFrame.new(Vector3.new(), Vector3.new(0,0,-1)) * CFrame.Angles(0, currentYaw, 0)).LookVector
                unicornWorldPos = unicornWorldPos + forwardDir * currentVelocity * dt
                unicornWorldPos = unicornWorldPos + Vector3.new(0, vSpeed * dt, 0)
                
                local pitchTarget = (vSpeed / 100) * math.rad(20)
                currentPitch = currentPitch + (pitchTarget - currentPitch) * 5 * dt
                currentBank = currentBank + (bankTarget - currentBank) * 5 * dt
                
                -- Limite de map
                local minX, maxX = -1425, 1454
                local minZ, maxZ = -1476, 1403
                if unicornWorldPos.X < minX or unicornWorldPos.X > maxX or unicornWorldPos.Z < minZ or unicornWorldPos.Z > maxZ then
                    local toCenter = Vector3.new(0, 0, 0) - unicornWorldPos
                    unicornWorldPos = unicornWorldPos + toCenter.Unit * currentVelocity * dt
                end
                
                unicornCF = CFrame.new(unicornWorldPos) * CFrame.Angles(0, currentYaw, 0) * CFrame.Angles(currentPitch, 0, currentBank) * CFrame.Angles(0, math.pi, 0)
                animTime = animTime + dt * (1 + currentVelocity / 50)
                
                -- Raycast atterrissage Ã¢â‚¬â€ filtre TOUTES les parts
                local rayOrigin = unicornWorldPos
                local rayDirection = Vector3.new(0, -UNICORN_HEIGHT - 10, 0)
                local rayParams = RaycastParams.new()
                local _ignoreList2 = {lp.Character}
                for _, pd in ipairs(unicornParts) do if pd.propModel then table.insert(_ignoreList2, pd.propModel) end end
                rayParams.FilterDescendantsInstances = _ignoreList2
                rayParams.FilterType = Enum.RaycastFilterType.Exclude

                local result = ws:Raycast(rayOrigin, rayDirection, rayParams)
                if result and vSpeed < 0 then
                    rideState = "manual_ground"
                    uNotif("Atterrissage rÃƒÂ©ussi !", 3)
                end
                
                if unicornForceReturn then
                    removeUnicornGUI()
                    unicornForceReturn = false
                    rideState = "returning"
                    waitStartTime = tick()
                    returnStartCF = unicornCF
                end
                
                if not isDriverSitting() then
                    removeUnicornGUI()
                    rideState = "idle"
                end
                
            elseif rideState == "auto_flight" then
                useFolded = false
                flightTime = flightTime + dt
                
                local currentSpeed = 100 + math.sin(flightTime * 0.5) * 50
                if uis:IsKeyDown(Enum.KeyCode.LeftShift) then
                    currentSpeed = 300
                end
                
                flightDistance = flightDistance + currentSpeed * dt
                local tSpeed = flightDistance / 800
                local maxRadX = 1400
                local maxRadZ = 1200
                
                local targetX = math.sin(tSpeed * 0.8) * maxRadX + math.sin(tSpeed * 1.5) * 200
                local targetZ = (1 - math.cos(tSpeed * 1.1)) * maxRadZ + math.sin(tSpeed * 0.7) * 250
                local heightOffset = math.sin(tSpeed * 2.0) * 80 + math.cos(tSpeed * 0.9) * 40
                
                unicornWorldPos = orbitCenter + Vector3.new(targetX, 140 + heightOffset, targetZ)
                
                local tNext = (flightDistance + 40) / 800
                local nextX = math.sin(tNext * 0.8) * maxRadX + math.sin(tNext * 1.5) * 200
                local nextZ = (1 - math.cos(tNext * 1.1)) * maxRadZ + math.sin(tNext * 0.7) * 250
                
                local dir = Vector3.new(nextX - targetX, 0, nextZ - targetZ).Unit
                
                local barrelRoll = 0
                if math.sin(tSpeed * 3) > 0.95 then
                    barrelRoll = (math.sin(tSpeed * 3) - 0.95) * 20 * math.pi
                end
                
                local bankAngle = math.sin(tSpeed * 1.5) * 0.5
                
                unicornCF = CFrame.lookAt(unicornWorldPos, unicornWorldPos - dir) * CFrame.Angles(0, 0, bankAngle + barrelRoll)
                animTime = animTime + dt * 1.5
                
                if flightTime > 60 or unicornForceReturn then
                    unicornForceReturn = false
                    rideState = "returning"
                    waitStartTime = tick()
                    returnStartCF = unicornCF
                    uNotif("Fin de la promenade ! Retour ÃƒÂ  la base.", 4)
                end
                
                -- Si le propriÃƒÂ©taire prend les commandes
                if isDriverSitting() and (uis:IsKeyDown(Enum.KeyCode.W) or uis:IsKeyDown(Enum.KeyCode.A) or uis:IsKeyDown(Enum.KeyCode.S) or uis:IsKeyDown(Enum.KeyCode.D)) then
                    setupUnicornGUI()
                    rideState = "manual_flight"
                    local _, yaw, _ = unicornCF:ToEulerAnglesYXZ()
                    currentYaw = yaw
                    currentPitch = 0
                    currentBank = 0
                    currentVelocity = currentSpeed
                    uNotif("Vous avez repris les commandes manuelles !", 4)
                end


            elseif rideState == "returning" then
                local elapsed = tick() - waitStartTime
                local returnTime = 10
                local returnProgress = math.min(elapsed / returnTime, 1)

                local currentRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                local targetPos = currentRoot and currentRoot.Position or orbitCenter
                local targetOrigin = CFrame.new(targetPos + Vector3.new(0,0,-15)) * CFrame.Angles(0, math.rad(90), 0)
                
                local targetCF = targetOrigin * CFrame.new(0, 38, 0)
                unicornCF = returnStartCF:Lerp(targetCF, returnProgress)
                
                if elapsed > returnTime then
                    rideState = "landing"
                    waitStartTime = tick()
                    spawnOrigin = targetOrigin
                end

            elseif rideState == "landing" then
                local elapsed = tick() - waitStartTime
                local landProgress = math.min(elapsed / 4, 1)
                
                local startH = 38
                local currentH = startH - (landProgress * (startH - 1))
                
                unicornCF = spawnOrigin * CFrame.new(0, currentH, 0)
                useFolded = (landProgress > 0.8) -- Commence a plier les pattes a la fin
                
                if elapsed > 4 then
                    unicornForceTakeoff = false
                    unicornForceReturn = false
                    rideState = "resting"
                end
            end

            -- Temps d'animation classique si on n'est pas en vol rapide
                if rideState ~= "flying" then
                    animTime = animTime + dt
                end

            for _, pData in ipairs(unicornParts) do
                local bp = pData.blueprint
                if bp and pData.scf then
                    local animDelta
                    if useFolded then
                        animDelta = getFoldedAnim(bp.key, animTime)
                    elseif bp.anim then
                        animDelta = bp.anim(animTime)
                    else
                        animDelta = CFrame.new()
                    end
                    local finalRot = bp.rot or CFrame.Angles(0,0,0)
                    local partCF = unicornCF * CFrame.new(bp.off) * finalRot * animDelta
                    uStream:setCF(pData.scf, partCF)
                end
            end
        end)
    end



